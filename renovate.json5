{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'group:pulumi',
    // Every action from outside this repository is referenced by commit, with
    // the release the commit resolves to beside it (framework/ci.md §3). The
    // preset pins a reference written by tag and moves the commit and the
    // comment together on a bump. It reads only a full `vX.Y.Z` tag as a
    // release, so the comment it writes names one release, never a major tag
    // such as `v5` that its publisher moves along the line.
    'helpers:pinGitHubActionDigestsToSemver',
  ],
  major: {
    // Major bumps are decisions, not chores.
    dependencyDashboardApproval: true,
  },
  patch: {
    // Patch-only PRs add noise without adding information: the minor groups
    // below carry them along.
    enabled: false,
  },
  // The release age. A route waits a week after a release is published
  // when CI executes that release with credentials in reach; a route whose
  // artifact the cluster only pulls does not wait. A poisoned release -- a
  // publisher's account or pipeline taken over -- is usually found and
  // yanked within days, and one yanked inside the week never runs in a job
  // holding this repository's tokens or a stack's secrets. The age is the
  // one the data source reports; for an action that is its tag's date,
  // which whoever pushes the tag writes, so a release made to look old is
  // not held back.
  //
  // Today the routes CI executes are the GitHub Actions and the runner
  // images their jobs run on; the Python dependencies; the `mise.toml`
  // toolchain, and the mise CI and a cloud session install it with; the
  // ZeroTier release the CI member installs; the Pulumi providers, the
  // bridged providers and their bridge, which run in `plan-physical` and
  // the previews with the stack secrets; and the packages and releases a
  // self-built image's recipe fetches while CI builds it. The Talos release
  // moves with `talosctl` and the appliance's age with the `age` of
  // `mise.toml`, in one pull request each, so both pairs wait whole. The
  // routes the cluster only pulls are the container images, by tag and by
  // digest, and the Helm charts: the first rule under `packageRules` takes
  // the age off them. The age is set here rather than per route, so a
  // route added later waits unless it is one of those. One more waits,
  // though the cluster only pulls it as it does a chart: the Gateway API
  // definitions, whose data source, `github-release-attachments`, the
  // exemption does not name. The exemption is one rule keyed by data source
  // alone, and a test holds the age to that shape.
  //
  // A data source that reports no release time cannot be aged, and two
  // waiting routes read such a source: the `deb` index the ZeroTier release
  // comes from, and `github-runners`. Renovate holds such an update rather
  // than proposing it unaged (its default `minimumReleaseAgeBehaviour`), and
  // it waits on the dependency dashboard until a person ticks it there.
  //
  // Lock file maintenance is the route renovate cannot age: it runs
  // `uv lock --upgrade` and takes whatever uv resolves. A direct bump's lock
  // is uv's too, for every library the new release pulls in. uv holds its
  // resolution to the same week itself -- `exclude-newer` in
  // `pyproject.toml`'s `[tool.uv]`, which the lock records as a span and not
  // a date -- and a test holds the two durations equal. Over `mise.lock`,
  // where renovate's host lets it run mise (the `toolchain` rule below), it
  // runs `mise lock --bump`, which moves no pin written as an exact version --
  // every pin `mise.toml` holds is one -- so it has nothing to age. What it can
  // move is the sum of a release uploaded again under its version, and
  // `mise.lock` is off noop-automerge's allow-list, so that waits for a reader.
  minimumReleaseAge: '7 days',
  lockFileMaintenance: {
    enabled: true,
  },
  // The uv that lock file maintenance and every Python bump's lock run with:
  // the one `mise.toml` pins, which every other `uv.lock` change is written
  // with. Renovate reads it from here first and from `[tool.uv]
  // required-version` second, and with neither it installs the newest uv.
  // A uv release writes the lock revision it defines, and releases have
  // moved it, so two uvs rewrite each other's revision on every lock change.
  // Renovate reads this line as a dependency of its own, and a rule below
  // reads it from the releases the mise pin is read from and puts it in the
  // toolchain group, so one release moves both pins in one pull request. A
  // test holds the two equal.
  constraints: {
    uv: '0.12.21',
  },
  dockerfile: {
    // The self-built images' recipes are `*.Containerfile`, which the
    // dockerfile manager does not look at by default. It reads their `FROM`
    // lines, each a tag with its digest, and moves the two together; the pins
    // written as build args live in the matching `.conf` and are covered by a
    // custom manager below.
    managerFilePatterns: [
      '/^docker/[^/]+\\.Containerfile$/',
    ],
  },
  ignorePaths: [
    // The generated SDKs, regenerated by `pulumi install` from the
    // `packages:` block of `Pulumi.yaml`. Each carries a `pyproject.toml` of
    // its own, which the pep621 manager would otherwise read as this
    // repository's dependencies; what moves them is the managers on the
    // block below.
    'sdks/**',
  ],
  // The regeneration workflow commits onto a renovate branch (framework/ci.md
  // §3), and a branch someone else has committed to is one renovate leaves
  // alone: it would neither rebase it nor move it to a newer release. Naming
  // the workflow's author keeps the branch renovate's own, so a newer release
  // -- or an advance of `main`, which `rebaseWhen: auto` follows under the
  // strict protection -- recreates the branch from renovate's commit, dropping
  // the regeneration, which the workflow then redoes on the new head. The
  // address is the one the workflow commits with, and a test holds the two
  // spellings equal.
  gitIgnoredAuthors: [
    'github-actions[bot]@users.noreply.github.com',
  ],
  // Merging is the CI's job, not renovate's: noop-automerge merges a PR whose
  // every changed path is on its allow-list — `uv.lock`, and a bump of
  // `Pulumi.yaml`'s `packages:` block with the `sdks/` it regenerates — once it has proven the preview is
  // empty (framework/ci.md §3), a zero-diff proof renovate cannot produce, and
  // every other PR waits for a reader. Two mechanisms racing would also mean
  // whichever wins picks the merge strategy, and renovate's squash rewrites
  // the committer.
  packageRules: [
    {
      // The routes whose artifact the cluster only pulls take no release
      // age (the top-level `minimumReleaseAge` says which routes wait, and
      // why): the container images and the Helm charts. Matched by data
      // source, so an image is one whichever manager reads it -- a
      // Containerfile's `FROM`, a `.conf` pin, a `versions:image-` pin in
      // `Pulumi.yaml`, the appliance's Postgres. A self-built image's base is
      // an image too, and exempt with the rest, though CI's image build runs
      // its layers. A test holds this rule to these two data sources.
      matchDatasources: [
        'docker',
        'helm',
      ],
      minimumReleaseAge: null,
    },
    // The groups below are cut by *what an upgrade moves*, not by how big the
    // version bump is. A single "non-major" group would put a Talos release
    // that reimages three nodes in the same PR as a typing-stub bump, and the
    // reviewer would have to take them or leave them together.
    {
      // Library upgrades that should change no resource at all. A bump that
      // rewrites only `uv.lock` can merge behind the zero-diff proof, and one
      // that edits `pyproject.toml` waits for a reader (framework/ci.md §3).
      // Either way it must not carry anything that legitimately produces a
      // diff.
      matchManagers: [
        'pep621',
        'pip_requirements',
      ],
      groupName: 'python dependencies',
      groupSlug: 'python',
    },
    {
      // The kubernetes provider, out of the python group and into one of its
      // own: `sdks/crds` is generated against one provider version and
      // registers its resources at that version, so `pyproject.toml` pins the
      // SDK exactly and the `packages:` entry of `Pulumi.yaml` names the same
      // release (framework/pulumi.md §4). Two managers read the one
      // dependency, pep621 the pin and a custom manager the entry, and this
      // rule puts both edits on one branch, which the regeneration workflow
      // finishes because it touches `Pulumi.yaml` (framework/ci.md §3). Left
      // in the python group, the bump would hold every other library bump red
      // until the SDK was regenerated.
      //
      // Position is load-bearing, the way the `jdx/mise-action` rule's is:
      // the last matching rule wins a field, so this sits *after* the rule
      // matching the pep621 manager, which reads the same pin. A test holds
      // the order.
      matchDepNames: [
        'pulumi-kubernetes',
      ],
      groupName: 'kubernetes provider',
      groupSlug: 'kubernetes-provider',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github actions',
      groupSlug: 'actions',
    },
    {
      // The runner images the workflows name (framework/ci.md §3), out of the
      // actions group and into one of their own. Two managers read them: the
      // github-actions one reads a label written in a `runs-on:`, and the
      // custom manager below reads one a matrix feeds to `runs-on:`, which
      // that manager skips. Matched by data source, which both halves share,
      // so the two architectures' labels move in one pull request.
      //
      // Position is load-bearing, as for the `jdx/mise-action` rule below:
      // this sits after the rule grouping the whole manager, so its group
      // wins. A test holds the order.
      matchDatasources: [
        'github-runners',
      ],
      groupName: 'runner images',
      groupSlug: 'runners',
    },
    {
      // The toolchain CI installs from. A pulumi or uv bump changes how every
      // other check runs, so it travels alone and is read: `mise.toml` is off
      // noop-automerge's allow-list (framework/ci.md §3), so a person merges
      // it.
      //
      // A bump is finished when `mise.lock` holds the new version and its
      // sum: `mise.toml` declares its tools locked, so an install refuses a
      // pin the lock has no entry for, and a test holds every pin to one. The
      // mise manager runs `mise lock` on the branch only where renovate's host
      // permits it to run mise (its `allowedUnsafeExecutions`); where it does
      // not, the pull request arrives without the entry and a person runs
      // `mise lock <tool>` onto it. The same holds for every mise pin a rule
      // below takes out of this group, today `kubeseal`, `talosctl`, `age`
      // and a major release of `postgres`.
      matchManagers: [
        'mise',
      ],
      groupName: 'toolchain',
      groupSlug: 'toolchain',
    },
    {
      // uv's second pin, `constraints.uv` above, beside the first. Renovate's
      // own `renovate-config` manager reads the constraint as the dependency
      // `uv`, from PyPI; the mise manager reads `mise.toml`'s `uv` from
      // `astral-sh/uv`'s GitHub releases. Read from the same releases here, so
      // both pins see one release at one time under the same release age, and
      // grouped with the toolchain, so one pull request moves both: apart,
      // each half fails the test that holds them equal.
      matchManagers: [
        'renovate-config',
      ],
      matchDepNames: [
        'uv',
      ],
      overrideDatasource: 'github-releases',
      overridePackageName: 'astral-sh/uv',
      groupName: 'toolchain',
      groupSlug: 'toolchain',
    },
    {
      // The toolchain again, by dependency rather than by manager: mise is
      // pinned where the workflows call its action, so the pin belongs to the
      // `github-actions` manager and would otherwise ride in the `github
      // actions` group above. It is the program that installs every other
      // pinned tool, so its bump changes how every other check runs —
      // exactly the reason the toolchain travels alone, and exactly what a
      // batch of unrelated action bumps would bury.
      //
      // Position is load-bearing: `packageRules` apply in order and the last
      // match wins a field, so this has to sit *after* the `github actions`
      // rule, which matches the same dependency by manager. Above it, the
      // group name would be silently overwritten back — a rule that looks
      // exactly like one that works, and one no check here would catch, since
      // renovate reads its configuration from the default branch and not from
      // a pull request. A test holds the order instead. Nothing after this
      // rule re-groups the dependency: those rules match by file name (paths a
      // workflow is not on) or by other dependency names.
      //
      // Both names, because the action and the program it fetches are separate
      // dependencies: the `version:` input the workflows pass to the action is
      // one renovate reads as a dependency of its own, named `jdx/mise`. That
      // half is the one carrying mise's own releases, so dropping it would
      // send exactly the bump this rule exists for back into the `github
      // actions` group. The cloud session's pin in
      // `deploy/cloud-session/toolchain.sh` carries the same name (the custom
      // manager below), so it moves in the same pull request.
      matchDepNames: [
        'jdx/mise-action',
        'jdx/mise',
      ],
      groupName: 'toolchain',
      groupSlug: 'toolchain',
    },
    {
      // Inside the cluster: the charts, the Gateway API definitions and the
      // container images the in-cluster stacks install, read off the
      // `versions:` block of `Pulumi.yaml` by the chart, manifest and image
      // managers below and applied by a rollout. Matched by the file those
      // managers read and the data sources they read through, which no other
      // pin in the file shares but the gateway's root filesystems: those are
      // images too, and the gateway rule further down takes them back into a
      // group of their own.
      //
      // Position is load-bearing, as for the `jdx/mise-action` rule: this sits
      // *before* the gateway rule, so the later rule's group wins for the
      // gateway's images, and before the Cilium rule, which takes the Cilium
      // chart into a group of its own. A test holds both orders.
      matchFileNames: [
        'Pulumi.yaml',
      ],
      matchDatasources: [
        'helm',
        'docker',
        'github-release-attachments',
      ],
      groupName: 'in-cluster charts and images',
      groupSlug: 'in-cluster',
    },
    {
      // Cilium's chart, out of the in-cluster group and into one of its own:
      // a Cilium bump replaces the datapath every node runs, the riskiest
      // upgrade operations.md §2.2 runs, so it travels alone and is read,
      // the way the Talos release does. The dependency is the chart pin's
      // key, `versions:chart-cilium`, whose `<name>` the chart managers take
      // as the dependency's name.
      //
      // Position is load-bearing, as for the `jdx/mise-action` rule: this sits
      // *after* the in-cluster rule, which matches the same pin by file and
      // data source, so its group wins. A test holds the order.
      matchFileNames: [
        'Pulumi.yaml',
      ],
      matchDepNames: [
        'cilium',
      ],
      groupName: 'cilium',
      groupSlug: 'cilium',
    },
    {
      // kubeseal, out of the toolchain group and into the in-cluster one,
      // beside the chart whose controller it seals for. `mise.toml` pins the
      // tool `credentials` seals the cluster's values with, and a test holds
      // it equal to the `appVersion` the sealed-secrets chart declares, which
      // `update_crds` records beside the bundle (framework/pulumi.md §4). So a
      // release has to move both in one pull request: apart, each half fails
      // that test on its own -- the tool's at once, the chart's once the
      // regeneration a chart bump needs anyway has rewritten the record.
      //
      // Matched by dependency alone, the mise manager's name for the pin, its
      // key under `[tools]`, the way the Talos rule matches `talosctl`. The
      // tool still waits the release age, which CI running it calls for, and
      // the chart does not.
      //
      // Position is load-bearing, as for the `jdx/mise-action` rule: this sits
      // *after* the rule grouping the whole mise manager as the toolchain, so
      // its group wins. Its group's name and slug are the in-cluster rule's,
      // since the slug names the branch. A test holds the order and the group.
      matchDepNames: [
        'kubeseal',
      ],
      groupName: 'in-cluster charts and images',
      groupSlug: 'in-cluster',
    },
    {
      // local-path-provisioner, whose every release is `v0.0.N`: docker
      // versioning reads each one as a patch, which the global
      // `patch: enabled: false` would drop, so its pin would never move. Its
      // patches are re-enabled here, and nothing else's; the update then
      // travels in the in-cluster group like any other chart or image bump.
      matchDepNames: [
        'docker.io/rancher/local-path-provisioner',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      enabled: true,
    },
    {
      // Outside the cluster: Talos, which reimages nodes. `physical` has no PR
      // preview by design (framework/ci.md §3), so this one is read as code
      // and approved before it is opened at all.
      //
      // Matched by dependency and not by file. Its pin lives in the
      // project-level `versions:` block of `Pulumi.yaml` (framework/pulumi.md
      // §3.2), which the chart and image pins share — and
      // an in-cluster chart bump must not inherit a gate that exists because
      // `physical` cannot be previewed.
      //
      // Two dependencies, one release. `siderolabs/talos` is the custom
      // manager's name for `versions:talos`; `talosctl` is the mise manager's
      // for `mise.toml`'s pin of the tool the suite validates the rendered
      // machine configuration with, which a test holds equal to the fleet's
      // release. Apart, each half fails that test on its own, so both move in
      // this one pull request under this one approval, and both are read from
      // releases -- the mise manager would read tags, and a tag pushed before
      // its release would put one half into the pull request ahead of the
      // other.
      //
      // A minor bump waits on Aetf/kluster-ops#475. A base generated for the
      // v1.14 contract carries a `KubeletConfig` document and refuses every
      // `machine.kubelet` field the component still renders, and the pinned
      // provider has no v1.14 documents to render instead. Approval is where
      // that gate is kept.
      //
      // Position is load-bearing, as for the `jdx/mise-action` rule: this sits
      // *after* the rule grouping the whole mise manager as the toolchain, so
      // its group wins for `talosctl`. A test holds the order.
      matchDepNames: [
        'siderolabs/talos',
        'talosctl',
      ],
      overrideDatasource: 'github-releases',
      groupName: 'talos and the node fleet',
      groupSlug: 'physical',
      dependencyDashboardApproval: true,
    },
    {
      // The appliance's pins change the box rather than a library: the
      // Postgres line and the age release replace it, and the Fedora CoreOS
      // release imports a new image that the next launch boots from, so they
      // travel alone and get read.
      matchFileNames: [
        'src/kluster/lib/state_backend/settings.py',
        'src/kluster/lib/state_backend/machine/**',
      ],
      groupName: 'state-backend appliance',
      groupSlug: 'state-backend',
    },
    {
      // The local age, into the appliance's group. `mise.toml` pins the age
      // this repository's tests run, and a test holds it equal to the
      // appliance's `settings.AGE_VERSION`, so a release has to move both
      // pins in one pull request: apart, each half fails that test on its own.
      // The mise manager reads the pin as the dependency `age` (its bundled
      // registry resolves the name to `FiloSottile/age` through the aqua
      // backend); the settings pin is a different dependency, named by the
      // custom manager below, and the rule above already groups it.
      //
      // Position is load-bearing, as for the `jdx/mise-action` rule: this sits
      // *after* the rule grouping the whole mise manager as the toolchain, so
      // its group wins. The group's name and slug are the rule above's, and a
      // test holds them equal: the slug names the branch, so a different one
      // would be a second pull request again.
      //
      // The dependency name is `mise.toml`'s key under `[tools]`, backend
      // prefix included, so respelling the pin there (`aqua:FiloSottile/age`)
      // takes it out of this rule; the test reads the name from here and
      // looks it up there.
      //
      // Read from releases, as the settings pin is: the aqua backend would
      // read tags, and a tag pushed before its release would put this half
      // into the pull request ahead of the other.
      //
      // Patch releases stay off for both age pins, unlike the self-built
      // images below, which take them back: the global
      // `patch: enabled: false` holds, so an age patch arrives folded into
      // the next minor release, and an advisory is handled by hand. age is
      // in no service's active path, since it encrypts the state-backend
      // dumps at rest, and the safety of what it has encrypted rests on the
      // algorithm rather than on the release that ran it. Every age bump
      // costs the appliance a replacement and a restore from a dump, a
      // patch as much as a minor.
      matchManagers: [
        'mise',
      ],
      matchDepNames: [
        'age',
      ],
      overrideDatasource: 'github-releases',
      groupName: 'state-backend appliance',
      groupSlug: 'state-backend',
    },
    {
      // The local Postgres client's lookup. The mise manager resolves
      // `mise.toml`'s `postgres` through mise's registry to the conda backend's
      // `postgresql` and reads it from the conda datasource under that bare
      // name, dropping the pin's `channel`. The datasource reads a package as
      // `<channel>/<name>` from api.anaconda.org, so the bare name finds
      // nothing, and the pin never moves. The name is the channel's here,
      // `conda-forge/postgresql`, which is the channel `mise.toml` writes and a
      // test holds the two equal. This rule goes once the mise manager passes
      // the channel on: a lookup with it removed then finds the package.
      //
      // Matched by datasource rather than manager: the conda datasource reaches
      // this repository only through that pin.
      matchDatasources: [
        'conda',
      ],
      matchDepNames: [
        'postgres',
      ],
      overridePackageName: 'conda-forge/postgresql',
    },
    {
      // The local Postgres client's major, into the appliance's group. The
      // appliance pins `POSTGRES_IMAGE` to a major alone, and a test holds the
      // client's major equal to it: `pg_dump` refuses a server of a newer
      // major than its own, and what a newer client writes is not guaranteed
      // to load into an older server. A major release therefore moves both
      // pins in one pull request, the appliance's; apart, each half fails that
      // test on its own. A minor or patch release of the client moves the
      // client alone, in the toolchain group, since the image's tag names no
      // minor.
      //
      // Position is load-bearing, as for the age rule above: this sits after
      // the rule grouping the whole mise manager as the toolchain, so its
      // group wins, and its name and slug are the appliance rule's, which a
      // test holds equal.
      matchDatasources: [
        'conda',
      ],
      matchDepNames: [
        'postgres',
      ],
      matchUpdateTypes: [
        'major',
      ],
      groupName: 'state-backend appliance',
      groupSlug: 'state-backend',
    },
    {
      // The self-built images (ci.md §4). Each pin here is one image, so they
      // travel one per pull request rather than grouped: a Postgres operand
      // rebuild and a proxy's version bump are not one decision. Patch
      // releases are re-enabled for them, because with no group to ride along
      // in, the global `patch: enabled: false` would drop them entirely —
      // and an image the cluster pins by exact tag never picks one up
      // implicitly.
      matchFileNames: [
        'docker/**',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      enabled: true,
    },
    {
      // The self-built images' `FROM` lines are pinned by digest (ci.md §4),
      // and one written without a digest gets a pull request adding it. Only
      // the dockerfile manager: a `.conf` pin carries its digest by the shape
      // the custom manager below reads, and a test holds every one to it.
      matchFileNames: [
        'docker/**',
      ],
      matchManagers: [
        'dockerfile',
      ],
      pinDigests: true,
    },
    {
      // A digest moving under an unchanged tag is the upstream rebuilding it,
      // which here is a rebuild under a new tag of ours: the published tag
      // carries a fingerprint of what the image is built from. Those refreshes
      // are not decisions the way a version bump is, so they travel together,
      // on the first of the month (the `schedule:monthly` preset's window):
      // one pull request, and one new tag per image, rather than one of each
      // per upstream rebuild.
      matchFileNames: [
        'docker/**',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      groupName: 'self-built image bases',
      groupSlug: 'image-bases',
      schedule: [
        '* 0-3 1 * *',
      ],
    },
    {
      // A pgvecto.rs release, read off the per-architecture tags in
      // `vchord-cnpg.conf`. It is an extension upgrade of immich's existing
      // database rather than a rebuild, so it waits on the dashboard, and the
      // two architectures' references move in one pull request: apart, the
      // image would pair two releases. Digest refreshes are not matched here
      // and stay in the monthly group above.
      matchDepNames: [
        'docker.io/tensorchord/pgvecto-rs-binary',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      dependencyDashboardApproval: true,
      groupName: 'pgvecto.rs release',
      groupSlug: 'pgvecto-rs',
    },
    {
      // The any-Terraform-provider bridge every SDK under `sdks/` is generated
      // with. One dependency written once per SDK, so one bump moves every
      // entry and regenerates every SDK; alone, because a bridge release
      // changes how each of them is generated, the way a toolchain bump
      // changes how every check runs.
      matchDepNames: [
        'pulumi/pulumi-terraform-provider',
      ],
      groupName: 'terraform-provider bridge',
      groupSlug: 'bridge',
    },
    {
      // The upstream providers those SDKs bridge. Grouped, so one regeneration
      // covers whatever moved. All three render in `physical`, which has no
      // PR preview (framework/ci.md §3), so a bump surfaces where every other
      // provider-SDK bump does: as a diff in `plan-physical` on main.
      matchDatasources: [
        'terraform-provider',
      ],
      groupName: 'bridged terraform providers',
      groupSlug: 'bridged-providers',
    },
    {
      // The gateway's container root filesystems. `physical` has no PR preview
      // either (framework/ci.md §3), but a rootfs bump swaps the software in
      // the router's containers rather than reimaging the node fleet, so it is
      // its own decision and not part of the Talos group.
      //
      // Grouped, because the publication is one build of all of them: a single
      // run produces every image and tags them all with its own number, so
      // there is no such thing as one of them moving on its own upstream. What
      // the four separate keys buy is the other direction — an operator can
      // hold one service back by hand while another proves a build, and no
      // grouping here takes that away.
      matchDepNames: [
        'ghcr.io/aetf/homelab-containers/**',
      ],
      groupName: 'gateway container root filesystems',
      groupSlug: 'gateway-rootfs',
      dependencyDashboardApproval: true,
    },
  ],
  customManagers: [
    {
      // The ZeroTier release the CI member installs from ZeroTier's own apt
      // repository (`.github/actions/zerotier/action.yml`), read off that
      // repository's package index for the suite the action names; a test
      // holds the two suites equal. A bump is a pull request a person merges:
      // the composite actions are off noop-automerge's allow-list. The global
      // `patch: enabled: false` holds here too, so a patch release arrives
      // with the next minor one.
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/actions/zerotier/action\\.yml$/',
      ],
      matchStrings: [
        "ZEROTIER_VERSION: '(?<currentValue>[^']+)'",
      ],
      depNameTemplate: 'zerotier-one',
      datasourceTemplate: 'deb',
      registryUrlTemplate: 'https://download.zerotier.com/debian/noble?suite=noble&components=main&binaryArch=amd64',
    },
    {
      // A runner label a matrix feeds to `runs-on:` -- the `runner:` key of
      // `images.yml`'s platforms. The github-actions manager reads only a
      // label written in `runs-on:` itself and skips an expression, so without
      // this the arm and amd64 legs would stay behind when every other job
      // moves. A test holds every such label to this pattern.
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/[^/]+\\.ya?ml$/',
      ],
      matchStrings: [
        '\\brunner: (?<depName>[a-z]+)-(?<currentValue>\\d[\\w.-]*)',
      ],
      datasourceTemplate: 'github-runners',
      versioningTemplate: 'docker',
    },
    {
      // The build-arg pins in `docker/*.conf`, each announced by a
      // `# renovate:` comment on the line above it, the same shape the
      // dockerfile manager uses in a Dockerfile. A pin without such a comment
      // is deliberately manual (golinks tracks a commit on a branch with no
      // releases, which is not a version stream).
      //
      // An image pin comes in one of two shapes, one pattern each. A version
      // key with its digest on the next line, a key ending in `_DIGEST`, is
      // the first pattern with the digest captured beside the version, so a
      // bump moves both and a refresh moves the digest alone. A whole
      // `<tag>@<digest>` in one value is the second, for a tag that is not a
      // version by itself: renovate refreshes its digest, and moves tag and
      // digest together on a release read off the tag through the
      // `versioning=` its hint names.
      customType: 'regex',
      managerFilePatterns: [
        '/^docker/[^/]+\\.conf$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s+[A-Za-z_][A-Za-z0-9_]*=(?<currentValue>\\d[\\w.+-]*)(?:\\s+[A-Za-z_][A-Za-z0-9_]*_DIGEST=(?<currentDigest>sha256:[0-9a-f]{64}))?',
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+[A-Za-z_][A-Za-z0-9_]*=(?<currentValue>[A-Za-z][\\w.-]*)@(?<currentDigest>sha256:[0-9a-f]{64})',
      ],
    },
    {
      // The mise a cloud session installs (framework/dispatch.md §1.4), which
      // is CI's: named `jdx/mise` here as the workflows' `mise-action`
      // `version:` inputs are, so the toolchain rule above puts both in one
      // pull request. A test holds the two equal.
      customType: 'regex',
      managerFilePatterns: [
        '/^deploy/cloud-session/toolchain\\.sh$/',
      ],
      matchStrings: [
        "mise_version=(?<currentValue>\\d[\\d.]*)",
      ],
      depNameTemplate: 'jdx/mise',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    {
      // The appliance's Postgres line and age release. AGE_SHA256 is not
      // renovate's to compute — CI recomputes it from the pinned URL and fails
      // the PR if the two disagree, so a bump cannot land unverified.
      customType: 'regex',
      managerFilePatterns: [
        '/^src/kluster/lib/state_backend/settings\\.py$/',
      ],
      matchStrings: [
        "POSTGRES_IMAGE = '(?<depName>[\\w./-]+):(?<currentValue>[\\w.-]+)'",
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^src/kluster/lib/state_backend/settings\\.py$/',
      ],
      matchStrings: [
        "AGE_VERSION = '(?<currentValue>v[\\d.]+)'",
      ],
      depNameTemplate: 'FiloSottile/age',
      datasourceTemplate: 'github-releases',
    },
    {
      // The Fedora CoreOS release the `state-backend` stack imports its image
      // from, and the digest of its compressed `oraclecloud` artifact, which
      // the upload checks the download against (rfc-006 ruling 7). One
      // manager for both, so a bump moves the pair: apart, the release would
      // land with a digest the next upload refuses. Read from the stream's
      // own metadata (`customDatasources` below), which publishes the current
      // release alone, its digest beside it and when it last moved. A bump
      // imports a new image and replaces nothing else; it falls in the
      // appliance's group by its file.
      customType: 'regex',
      managerFilePatterns: [
        '/^src/kluster/lib/state_backend/settings\\.py$/',
      ],
      matchStrings: [
        "FCOS_RELEASE = '(?<currentValue>[\\d.]+)'\\nFCOS_ARTIFACT_SHA256 = '(?<currentDigest>[0-9a-f]{64})'",
      ],
      depNameTemplate: 'fedora-coreos',
      datasourceTemplate: 'custom.fedora-coreos-stable',
      versioningTemplate: 'loose',
    },
    {
      // The Talos version is a Pulumi config value, which no manager reads. It
      // lives in the project-level `versions:` namespace, so one file holds it
      // for every stack (framework/pulumi.md §3.2).
      customType: 'regex',
      managerFilePatterns: [
        '/^Pulumi\\.yaml$/',
      ],
      matchStrings: [
        'versions:talos:\\s*(?<currentValue>v[\\d.]+)',
      ],
      depNameTemplate: 'siderolabs/talos',
      datasourceTemplate: 'github-releases',
    },
    {
      // The bridge release in the `packages:` block, which is the first of
      // the two lines every entry is pinned by. Its releases are tagged
      // `v<version>`, the block holds the bare number, and one pattern reaches
      // every entry so the bump lands on all of them at once. A bump is not
      // finished by the block alone: the SDKs under `sdks/` are what the
      // program imports, and a workflow regenerates them on the branch
      // (framework/ci.md §3).
      customType: 'regex',
      managerFilePatterns: [
        '/^Pulumi\\.yaml$/',
      ],
      matchStrings: [
        'source: terraform-provider\\s+version: (?<currentValue>\\d[\\d.]*)',
      ],
      depNameTemplate: 'pulumi/pulumi-terraform-provider',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
    {
      // The upstream provider each entry is parameterized with: the second of
      // the two pinned lines, read off the `parameters:` pair as the bridge
      // reads it. Resolved against the OpenTofu registry because that is the
      // registry the bridge fetches from -- the SDK's own `pulumi-plugin.json`
      // records the coordinates under `registry.opentofu.org` -- so what
      // renovate sees as the newest release is what `pulumi install` will get.
      customType: 'regex',
      managerFilePatterns: [
        '/^Pulumi\\.yaml$/',
      ],
      matchStrings: [
        'source: terraform-provider\\s+version: [\\d.]+\\s+parameters:\\s+- (?<depName>[\\w.-]+/[\\w.-]+)\\s+- (?<currentValue>\\d[\\d.]*)',
      ],
      datasourceTemplate: 'terraform-provider',
      registryUrlTemplate: 'https://registry.opentofu.org',
    },
    {
      // The kubernetes provider release the `crds` entry of the `packages:`
      // block generates its SDK with. It is the release `pyproject.toml` pins
      // exactly, so it is read as the same dependency through the same data
      // source, and the newest release renovate sees for the one is the
      // newest it sees for the other; the `kubernetes provider` rule above
      // puts the two edits on one branch.
      customType: 'regex',
      managerFilePatterns: [
        '/^Pulumi\\.yaml$/',
      ],
      matchStrings: [
        'source: kubernetes\\s+version: (?<currentValue>\\d[\\d.]*)',
      ],
      depNameTemplate: 'pulumi-kubernetes',
      datasourceTemplate: 'pypi',
    },
    {
      // The chart pins served from an HTTP chart repository: the key's
      // `<name>` is the chart, `repository` the repository and `version` the
      // version, read through the Helm data source off the repository's
      // index. Each pin is an object under `value:`, and the three are the
      // first lines after it (framework/pulumi.md §3.2). A bump of a pin
      // `update_crds` reads is finished by running it on the branch, which
      // rewrites the record `packages/crds` carries of the block.
      customType: 'regex',
      managerFilePatterns: [
        '/^Pulumi\\.yaml$/',
      ],
      matchStrings: [
        'versions:chart-(?<depName>[\\w-]+):\\s+value:\\s+repository: (?<registryUrl>https://\\S+)\\s+version: (?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'helm',
    },
    {
      // The chart pins served from an OCI registry, which carry the digest of
      // the chart's manifest beside the version. An OCI chart is an artifact
      // in a container registry, so it is read through the docker data source
      // -- as renovate's own Helm managers read one
      // (`lib/modules/manager/helmv3/oci.ts`) -- which moves the version and
      // the digest together, the way it moves an image's tag and digest. The
      // package is the registry path with the chart's name appended, which is
      // the reference Helm pulls.
      customType: 'regex',
      managerFilePatterns: [
        '/^Pulumi\\.yaml$/',
      ],
      matchStrings: [
        'versions:chart-(?<depName>[\\w-]+):\\s+value:\\s+repository: oci://(?<registry>\\S+)\\s+version: (?<currentValue>\\S+)\\s+digest: (?<currentDigest>sha256:[0-9a-f]{64})',
      ],
      packageNameTemplate: '{{{registry}}}/{{{depName}}}',
      datasourceTemplate: 'docker',
    },
    {
      // The release manifest pins: a GitHub release, one of its assets and the
      // asset's sha256, captured in one match so the release and the digest
      // move together. `github-release-attachments` is the data source that
      // maintains a digest: it finds the pinned asset in the current release by
      // its sha256, from a checksum file the release publishes or, where there
      // is none, by hashing the assets, and hashes the same asset of the next
      // release (`lib/modules/datasource/github-release-attachments/index.ts`).
      // A bump is finished by running `update_crds`, as for a chart.
      customType: 'regex',
      managerFilePatterns: [
        '/^Pulumi\\.yaml$/',
      ],
      matchStrings: [
        'versions:manifest-[\\w-]+:\\s+value:\\s+repository: (?<depName>[\\w.-]+/[\\w.-]+)\\s+release: (?<currentValue>\\S+)\\s+asset: \\S+\\s+sha256: (?<currentDigest>[0-9a-f]{64})',
      ],
      datasourceTemplate: 'github-release-attachments',
    },
    {
      // The image pins in the same project-level block. Each value is a whole
      // reference, so repository, tag and digest all come off the line and no
      // annotation comment is needed to say what is being pinned
      // (framework/pulumi.md §3.2).
      //
      // Tag and digest are captured together, so one data source moves the
      // pair and the reference the program pulls by stays whole. A tag is
      // read as docker versioning reads it, so how a bump arrives is the
      // publisher's tagging scheme. The gateway's images are tagged by this
      // repository's publication with a monotonic run number, which docker
      // versioning reads as a major version — so each of their bumps is a
      // decision that waits on the dashboard, which for software the site's
      // router runs is the right default; the commit-hash tag beside it is
      // not a version and is ignored. A third-party image carries its
      // upstream's release tag, so its bumps are majors, minors or patches as
      // that upstream numbers them, and a patch reaches a pull request only
      // where a package rule re-enables it (local-path-provisioner's, above).
      customType: 'regex',
      managerFilePatterns: [
        '/^Pulumi\\.yaml$/',
      ],
      matchStrings: [
        'versions:image-[\\w-]+:\\s*(?<depName>\\S+?):(?<currentValue>[^\\s:@/]+)@(?<currentDigest>sha256:[0-9a-f]{64})',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  customDatasources: {
    // Fedora CoreOS's stable stream, as the release the stream publishes now,
    // the sha256 of that release's compressed `oraclecloud` disk, and when
    // the stream last moved, which `minimumReleaseAge` ages it by. Read by
    // the manager for `FCOS_RELEASE` above.
    'fedora-coreos-stable': {
      defaultRegistryUrlTemplate: 'https://builds.coreos.fedoraproject.org/streams/stable.json',
      format: 'json',
      transformTemplates: [
        '{"releases": [{"version": architectures.x86_64.artifacts.oraclecloud.release, "digest": architectures.x86_64.artifacts.oraclecloud.formats.`qcow2.xz`.disk.sha256, "releaseTimestamp": metadata.`last-modified`}], "homepage": "https://fedoraproject.org/coreos/"}',
      ],
    },
  },
}
