{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'group:pulumi',
  ],
  major: {
    // Major bumps are decisions, not chores.
    dependencyDashboardApproval: true,
  },
  patch: {
    // Patch-only PRs add noise without adding information: the minor groups
    // below carry them along.
    enabled: false,
  },
  lockFileMaintenance: {
    enabled: true,
  },
  ignorePaths: [
    // Generated bindings; they are regenerated by `uv run update_crds`.
    'packages/crds/**',
    // Vendored copies of pulumi/agent-skills, pinned in skills-lock.json by
    // content hash rather than by version: renovate has no currentValue to
    // compare, so it cannot see them at all. `skills-drift` watches them
    // instead, in the weekly drift workflow -- by comparing bytes against the
    // source repository, because the lock's own hash is not reproducible from
    // an installed copy (vercel-labs/skills#806).
    '.agents/**',
  ],
  // Merging is the CI's job, not renovate's: the deploy workflow merges a PR
  // once it has proven the preview is empty (framework/ci.md §3) — a zero-diff
  // proof renovate cannot produce. Two mechanisms racing would also mean
  // whichever wins picks the merge strategy, and renovate's squash rewrites
  // the committer.
  packageRules: [
    // The groups below are cut by *what an upgrade moves*, not by how big the
    // version bump is. A single "non-major" group would put a Talos release
    // that reimages three nodes in the same PR as a typing-stub bump, and the
    // reviewer would have to take them or leave them together.
    {
      // Library upgrades that should change no resource at all. This is the
      // one group the zero-diff proof can wave through unattended
      // (framework/ci.md §3), which is exactly why it must not carry anything
      // that legitimately produces a diff.
      matchManagers: [
        'pep621',
        'pip_requirements',
      ],
      groupName: 'python dependencies',
      groupSlug: 'python',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github actions',
      groupSlug: 'actions',
    },
    {
      // The toolchain CI installs from. A pulumi or uv bump changes how every
      // other check runs, so it travels alone and is read.
      matchManagers: [
        'mise',
      ],
      groupName: 'toolchain',
      groupSlug: 'toolchain',
    },
    {
      // Inside the cluster: chart versions and container images, applied by a
      // rollout. Blast radius is one workload.
      matchFileNames: [
        'Pulumi.k8s-base.yaml',
        'Pulumi.apps.yaml',
        'Pulumi.dns.yaml',
      ],
      groupName: 'in-cluster charts and images',
      groupSlug: 'in-cluster',
    },
    {
      // Outside the cluster: Talos, which reimages nodes. `physical` has no PR
      // preview by design (framework/ci.md §3), so this one is read as code
      // and approved before it is opened at all.
      matchFileNames: [
        'Pulumi.physical.yaml',
      ],
      groupName: 'talos and the node fleet',
      groupSlug: 'physical',
      dependencyDashboardApproval: true,
    },
    {
      // The appliance's pins are re-provision triggers rather than library
      // upgrades: each one means terminating and relaunching the box, so they
      // travel alone and get read.
      matchFileNames: [
        'src/kluster/scripts/state_backend/settings.py',
        'deploy/state-backend/**',
      ],
      groupName: 'state-backend appliance',
      groupSlug: 'state-backend',
    },
  ],
  customManagers: [
    {
      // The appliance's Postgres line and age release. AGE_SHA256 is not
      // renovate's to compute — CI recomputes it from the pinned URL and fails
      // the PR if the two disagree, so a bump cannot land unverified.
      customType: 'regex',
      managerFilePatterns: [
        '/^src/kluster/scripts/state_backend/settings\\.py$/',
      ],
      matchStrings: [
        "POSTGRES_IMAGE = '(?<depName>[\\w./-]+):(?<currentValue>[\\w.-]+)'",
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^src/kluster/scripts/state_backend/settings\\.py$/',
      ],
      matchStrings: [
        "AGE_VERSION = '(?<currentValue>v[\\d.]+)'",
      ],
      depNameTemplate: 'FiloSottile/age',
      datasourceTemplate: 'github-releases',
    },
    {
      // The Talos version is stack config, which no manager reads. The file
      // does not exist until the stack is created; renovate ignores a pattern
      // that matches nothing, so this waits rather than needing to be
      // remembered later.
      customType: 'regex',
      managerFilePatterns: [
        '/^Pulumi\\.physical\\.yaml$/',
      ],
      matchStrings: [
        'kluster:talosVersion:\\s*(?<currentValue>v[\\d.]+)',
      ],
      depNameTemplate: 'siderolabs/talos',
      datasourceTemplate: 'github-releases',
    },
  ],
}
