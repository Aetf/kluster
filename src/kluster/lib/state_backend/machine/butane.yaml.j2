# The state-backend appliance, whole (docs/physical/state-backend.md).
#
# Rendered to Ignition by the `state-backend` stack and delivered as OCI
# user_data: the box is defined here and nowhere else, and a change to it is
# applied by replacing the box. Nothing on it is mutated in place, so anything
# missing from this file does not exist on the machine.
#
# Secrets ride Ignition deliberately (§1): no untrusted workload runs here, so
# instance metadata is readable only by the instance itself and by OCI
# principals who are root-equivalent for this box anyway.
#
# Two Postgres roles are this box's alone, so they are named here rather than
# in `settings.py`: no client ever connects as either, and a change to either
# name is a change to this file, which the box's bill of materials digests whole.
#   - `superuser` is the image's bootstrap superuser. It answers on the
#     server's Unix sockets and nowhere else (pg_hba below): the container's
#     own, and the one the pooler's container shares. Its users are the
#     image's own initialization and the dump timer.
#   - `owner` owns the state. It cannot log in: the two client roles are its
#     members, and every session they open acts as it (00-roles.sql below).
#
# Two containers serve the state. PgBouncer is the only one the network
# reaches: it holds the TLS listener and checks every client certificate, and
# it runs at most `pool_cap` statements in Postgres at once, beside one dump or
# restore, so a client beyond that waits in it rather than adding a server
# process. Postgres has
# no network at all. It serves the pooler on a Unix socket in `socket_dir`,
# a directory the two containers share and nothing else on the box can enter.
{%- set superuser = 'postgres' %}
{%- set owner = 'state_owner' %}
{%- set socket_dir = '/var/lib/pgstate-socket' %}
{%- set socket_mount = '/run/pgstate-socket' %}
variant: fcos
version: 1.5.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
{%- for key in operator_keys %}
        - {{ key }}
{%- endfor %}

storage:
  directories:
    - path: /var/lib/pgstate
      mode: 0700
      user:
        id: {{ postgres_uid }}
      group:
        id: {{ postgres_uid }}
    - path: /etc/kluster/pki
      mode: 0755
    - path: /etc/kluster/pgstate
      mode: 0755
    - path: /etc/kluster/pgbouncer
      mode: 0755
    # Postgres's socket for the pooler. Postgres creates the socket, so the
    # directory is its; the pooler enters it through the group; and no other
    # user does, which is what keeps the trust pg_hba gives the client roles
    # on that socket (below) from reaching past the pooler.
    - path: {{ socket_dir }}
      mode: 0750
      user:
        id: {{ postgres_uid }}
      group:
        id: {{ pgbouncer_gid }}
    - path: /etc/kluster/initdb
      mode: 0755
    - path: /opt/bin
      mode: 0755
    # Where a failed dump leaves its notice. Fedora CoreOS prints
    # /etc/motd.d/* at an interactive ssh login — a plain `state-backend
    # ssh`; one given a command prints none — and that login is the one
    # human channel this box has.
    - path: /etc/motd.d
      mode: 0755

  files:
    # --- PKI: issued from the escrowed CA (credentials.md §2.2) ------------
    - path: /etc/kluster/pki/ca.crt
      mode: 0644
      contents:
        inline: |
{{ ca_cert | indent(10, true) }}
    - path: /etc/kluster/pki/server.crt
      mode: 0644
      user:
        id: {{ pgbouncer_uid }}
      group:
        id: {{ pgbouncer_gid }}
      contents:
        inline: |
{{ server_cert | indent(10, true) }}
    - path: /etc/kluster/pki/server.key
      mode: 0600
      user:
        id: {{ pgbouncer_uid }}
      group:
        id: {{ pgbouncer_gid }}
      contents:
        inline: |
{{ server_key | indent(10, true) }}

    # --- The box's SSH identity, minted by the same render (§1) ----------
    # Delivered rather than generated on the box, so that the launch can
    # record the public half in the instance's metadata before the box boots
    # and `state-backend ssh` can refuse anything else: first contact with
    # this machine is never trust-on-first-use. Fedora CoreOS uses what is
    # here as-is -- `sshd-keygen@.service` carries
    # `ConditionFileNotEmpty=|!/etc/ssh/ssh_host_%i_key`, so it runs only for
    # a key type whose file is missing or empty, and the other types it does
    # generate are the ones the client is told not to accept.
    #
    # The public half is written too, and not because sshd needs it: the
    # console banner's fingerprints are read from these `.pub` files, and
    # that banner is the one channel for checking the pin against something
    # the Ignition never touched.
    - path: /etc/ssh/ssh_host_ed25519_key
      mode: 0600
      contents:
        inline: |
{{ ssh_host_key | indent(10, true) }}
    - path: /etc/ssh/ssh_host_ed25519_key.pub
      mode: 0644
      contents:
        inline: |
          {{ ssh_host_key_pub }}

    # --- The pooler: the box's one listener on the network ----------------
    # Who may connect, as whom, and how; a connection no line matches is
    # refused. From the network a certificate is the only way in, a client
    # certificate's CN is the role it becomes, and only the two client roles
    # and `upkeep` may become one, into the state's entries alone: the
    # session entry `operator` alone, and `upkeep` the transaction entry
    # alone. The CA can sign any CN, and this is what makes a certificate
    # naming the superuser worth nothing. The statistics console
    # is admitted on the pooler's own socket only, inside its container,
    # which is `podman exec` as root on this box.
    - path: /etc/kluster/pgbouncer/hba.conf
      mode: 0644
      contents:
        inline: |
          local    pgbouncer               pgbouncer                                                    trust
          hostssl  {{ database }}          {{ ci_role }},{{ operator_role }},{{ upkeep_role }}  0.0.0.0/0  cert
          hostssl  {{ database }}          {{ ci_role }},{{ operator_role }},{{ upkeep_role }}  ::/0       cert
          hostssl  {{ session_database }}  {{ operator_role }}                                   0.0.0.0/0  cert
          hostssl  {{ session_database }}  {{ operator_role }}                                   ::/0       cert

    # The users the pooler knows. It looks a user up here before any method
    # applies, and none of these is a password: the methods above are the
    # certificate and, inside the container, trust.
    - path: /etc/kluster/pgbouncer/userlist.txt
      mode: 0644
      contents:
        inline: |
          "{{ ci_role }}" ""
          "{{ operator_role }}" ""
          "{{ upkeep_role }}" ""
          "pgbouncer" ""

    # The pooler itself (state-backend.md §2).
    #   - TLS: a certificate a client presents is verified against the CA in
    #     the handshake, and one from another authority ends it there; the
    #     `cert` lines above then refuse a connection that presented none and
    #     map a verified one's CN to a role. `require` rather than
    #     `verify-full`: `verify-full` answers a handshake that presents no
    #     certificate with alert 116 after the client's side of it
    #     completes, so whether the expiry probe's `openssl s_client` exits 0
    #     is a race, and the probe (`state-backend probe`) would fail some
    #     runs. `require` admits the same connections and keeps the probe
    #     deterministic.
    #   - Two entries for the one database. The transaction entry, the
    #     database's own name, carries every `pulumi` session and every
    #     query, every role's: a client holds a server process for one
    #     transaction, and `max_db_connections` holds the entry's pools,
    #     every role's, to `pool_cap` server processes between them. The
    #     session entry carries `pg_dump` and `pg_restore`, one session at a
    #     time: they set session state -- `pg_restore`'s empty `search_path`,
    #     which outlasts its transaction, among it -- that the transaction
    #     entry would hand the next `pulumi` session.
    #   - A client beyond an entry's cap waits up to `query_wait_timeout`, the
    #     longest a dump or restore holds the session entry; `max_client_conn`
    #     is the clients the pooler holds at once.
    #   - `max_prepared_statements = 0`: the clients use unnamed statements,
    #     and a pooler tracking prepared statements would hold a whole Parse
    #     in memory rather than stream it.
    #   - A setting a client opens its session with reaches every server
    #     process that serves it only where PgBouncer tracks the setting, and
    #     it refuses at the startup a client naming one it does not. It tracks
    #     `default_transaction_read_only` by itself, which is what keeps a
    #     census session read-only through it; the census case of
    #     `tests/test_state_roles.py` fails on a release that does not.
    - path: /etc/kluster/pgbouncer/pgbouncer.ini
      mode: 0644
      contents:
        inline: |
          [databases]
          {{ database }} = host={{ socket_mount }} dbname={{ database }} pool_mode=transaction pool_size={{ pool_cap }} max_db_connections={{ pool_cap }}
          {{ session_database }} = host={{ socket_mount }} dbname={{ database }} pool_mode=session pool_size=1 max_db_connections=1

          [pgbouncer]
          listen_addr = 0.0.0.0
          listen_port = {{ port }}
          unix_socket_dir = /tmp
          auth_type = hba
          auth_hba_file = /etc/pgbouncer/hba.conf
          auth_file = /etc/pgbouncer/userlist.txt
          client_tls_sslmode = require
          client_tls_ca_file = /pki/ca.crt
          client_tls_cert_file = /pki/server.crt
          client_tls_key_file = /pki/server.key
          max_client_conn = {{ max_clients }}
          query_wait_timeout = {{ pool_wait_seconds }}
          max_prepared_statements = 0
          stats_users = pgbouncer

    # --- Postgres ------------------------------------------------------------
    # Who may connect, as whom, and how; a connection no line matches is
    # refused. Every line is a local socket's, since Postgres has no network,
    # and a `local` line matches both sockets the server listens on: the
    # container's own and the one the pooler's container shares. So the
    # superuser, and the client roles and `upkeep` into the state's database
    # alone, are each reachable from the pooler's container as well as by
    # `podman exec`; the pooler connects as one of the latter only once it
    # has checked a certificate naming it. Neither socket is reachable from
    # outside the two containers -- getting there is `podman exec` as root on
    # this box -- so both are trusted and carry no credential. The pooler's
    # container already holds the server key and connects as both client
    # roles, so it already reaches the whole state; the superuser adds code
    # execution beside the same data and no data it could not already
    # reach (threat-model.md §4, clause 2, accepted).
    - path: /etc/kluster/pgstate/pg_hba.conf
      mode: 0644
      user:
        id: {{ postgres_uid }}
      group:
        id: {{ postgres_uid }}
      contents:
        inline: |
          local    all             {{ superuser }}                                        trust
          local    {{ database }}  {{ ci_role }},{{ operator_role }},{{ upkeep_role }}  trust

    # Run once, by the image's entrypoint, when it initializes an empty data
    # directory: as the superuser, connected to {{ database }}.
    - path: /etc/kluster/initdb/00-roles.sql
      mode: 0644
      contents:
        inline: |
          -- The client roles are certificate subjects, so they carry no
          -- passwords, and neither is a superuser: what they hold is what
          -- Pulumi's Postgres backend needs and nothing else
          -- (docs/physical/state-backend.md §2).
          --
          -- That is ownership of its table, not only rows in it. Every time
          -- the backend opens, it runs `CREATE TABLE IF NOT EXISTS` and
          -- `CREATE INDEX IF NOT EXISTS`, and Postgres checks CREATE on the
          -- schema, and ownership of the table, before it looks for either
          -- object: a role that can only read and write rows is refused on
          -- its first command. So the table belongs to {{ owner }}, both
          -- client roles are its members, and every session either opens acts
          -- as it -- which is what makes the table the backend creates at
          -- first use, and everything a restore loads, belong to the owner,
          -- whichever client got there first.
          CREATE ROLE {{ owner }} NOLOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE;
          CREATE ROLE {{ ci_role }} LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE IN ROLE {{ owner }};
          CREATE ROLE {{ operator_role }} LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE IN ROLE {{ owner }};
          ALTER ROLE {{ ci_role }} IN DATABASE {{ database }} SET role = {{ owner }};
          ALTER ROLE {{ operator_role }} IN DATABASE {{ database }} SET role = {{ owner }};
          REVOKE ALL ON DATABASE {{ database }} FROM PUBLIC;
          GRANT CONNECT ON DATABASE {{ database }} TO {{ owner }};
          GRANT USAGE, CREATE ON SCHEMA public TO {{ owner }};
          --
          -- A large object is persistent, and outside every table's grant:
          -- any role may create one unless the functions that do are revoked.
          -- No client of this box uses one, so the three that create one are
          -- revoked from every role; the server-side `lo_import` is the
          -- superuser's alone already.
          REVOKE EXECUTE ON FUNCTION lo_creat(integer), lo_create(oid), lo_from_bytea(oid, bytea) FROM PUBLIC;
          --
          -- `upkeep` is the cluster's daily upkeep of the state table: the
          -- census, the prune of expired rows and the ceiling. It reads and
          -- deletes rows, with the lock on the table that `DELETE` carries,
          -- and nothing more, so it is no member of {{ owner }} and acts as
          -- itself. Its grant on the table is a
          -- default privilege of {{ owner }}'s, because the table does not
          -- exist yet and comes to exist in two ways, each a session acting
          -- as {{ owner }}: the backend's first open, and every restore, whose
          -- `--clean` drops the table and creates it again. A restore takes
          -- no privileges from the archive (`state.pg_restore`), so this
          -- default privilege is what grants the restored table to
          -- `upkeep`, and an archive restores into a box with or without
          -- the role.
          CREATE ROLE {{ upkeep_role }} LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE;
          GRANT CONNECT ON DATABASE {{ database }} TO {{ upkeep_role }};
          GRANT USAGE ON SCHEMA public TO {{ upkeep_role }};
          ALTER DEFAULT PRIVILEGES FOR ROLE {{ owner }} IN SCHEMA public GRANT SELECT, DELETE ON TABLES TO {{ upkeep_role }};

    # --- Backup pipeline ---------------------------------------------------
    - path: /etc/kluster/age-recipients.txt
      mode: 0644
      contents:
        inline: |
{%- for recipient in age_recipients %}
          {{ recipient }}
{%- endfor %}

    # The dump reaches Postgres through `podman exec`, over the local socket,
    # so the role it connects as is the one pg_hba admits there.
    - path: /etc/kluster/state-dump.env
      mode: 0600
      contents:
        inline: |
          PG_DATABASE={{ database }}
          PG_ROLE={{ superuser }}
          B2_KEY_ID={{ b2_dump_key_id }}
          B2_KEY={{ b2_dump_key }}
          B2_BUCKET_ID={{ b2_bucket_id }}
          B2_PREFIX={{ b2_prefix }}

    - path: /usr/local/bin/state-dump
      mode: 0755
      contents:
        inline: |
{{ dump_script | indent(10, true) }}

    # Reboots land in a known window: the blip is the same either way, but a
    # scheduled one is never mistaken for an incident.
    - path: /etc/zincati/config.d/55-updates-strategy.toml
      mode: 0644
      contents:
        inline: |
          [updates]
          strategy = "periodic"

          [[updates.periodic.window]]
          days = [ "{{ reboot_day }}" ]
          start_time = "{{ reboot_time }}"
          length_minutes = {{ reboot_window_minutes }}

  links:
    - path: /etc/localtime
      target: ../usr/share/zoneinfo/UTC
      overwrite: true

systemd:
  units:
    # Postgres, at the image `settings.POSTGRES_IMAGE` pins by digest: the box
    # runs exactly that image, and nothing on it moves to another. A new
    # digest reaches the box by pull request and a replacement.
    #
    # `POSTGRES_HOST_AUTH_METHOD=trust` is what lets the image initialize a
    # superuser that has no password. The pg_hba.conf it writes into the data
    # directory to match is never read: `hba_file` names the one above.
    #
    # The container has no network, and the clients reach the server on the
    # socket in the shared directory, the second of `unix_socket_directories`;
    # the first is the image's own, where `podman exec` reaches it. The one TCP
    # address is the container's loopback, which nothing outside it reaches
    # and pg_hba admits no one on: it is how the pooler's unit tells the
    # serving Postgres from the image's initialization, whose temporary server
    # listens on the sockets alone. The shared directory is labelled `z`,
    # shared, since both containers mount it.
    - name: pgstate.service
      enabled: true
      contents: |
        [Unit]
        Description=Pulumi state Postgres
        After=network-online.target
        Wants=network-online.target

        [Service]
        Restart=always
        RestartSec=10
        ExecStartPre=-/usr/bin/podman rm -f pgstate
        ExecStart=/usr/bin/podman run --replace --name pgstate \
          --network none \
          --shm-size 128m \
          --env POSTGRES_DB={{ database }} \
          --env POSTGRES_USER={{ superuser }} \
          --env POSTGRES_HOST_AUTH_METHOD=trust \
          --volume /var/lib/pgstate:/var/lib/postgresql/data:Z \
          --volume /etc/kluster/pgstate:/config:ro,Z \
          --volume /etc/kluster/initdb:/docker-entrypoint-initdb.d:ro,Z \
          --volume {{ socket_dir }}:{{ socket_mount }}:z \
          {{ postgres_image }} \
          postgres \
            -c listen_addresses=127.0.0.1 \
            -c unix_socket_directories=/var/run/postgresql,{{ socket_mount }} \
            -c shared_buffers={{ shared_buffers_mib }}MB \
            -c hba_file=/config/pg_hba.conf
        ExecStop=/usr/bin/podman stop -t 30 pgstate

        [Install]
        WantedBy=multi-user.target

    # PgBouncer, at the image `settings.PGBOUNCER_IMAGE` pins by digest, run by
    # the image's own entrypoint against the configuration above. It starts
    # once Postgres serves -- the server answering on its loopback, which the
    # image's initialization never does -- so the first TLS handshake the box
    # completes is one whose client the state already answers; a box's first
    # boot pulls both images and initializes the data directory before that.
    - name: pgbouncer.service
      enabled: true
      contents: |
        [Unit]
        Description=Pulumi state PgBouncer
        Requires=pgstate.service
        After=pgstate.service network-online.target
        Wants=network-online.target

        [Service]
        Restart=always
        RestartSec=10
        TimeoutStartSec=15min
        ExecStartPre=/usr/bin/bash -c 'until /usr/bin/podman exec pgstate pg_isready --quiet --host=127.0.0.1; do sleep 2; done'
        ExecStartPre=-/usr/bin/podman rm -f pgbouncer
        ExecStart=/usr/bin/podman run --replace --name pgbouncer \
          --publish {{ port }}:{{ port }} \
          --volume /etc/kluster/pki:/pki:ro,Z \
          --volume /etc/kluster/pgbouncer:/etc/pgbouncer:ro,Z \
          --volume {{ socket_dir }}:{{ socket_mount }}:z \
          {{ pgbouncer_image }}
        ExecStop=/usr/bin/podman stop -t 30 pgbouncer

        [Install]
        WantedBy=multi-user.target

    # age is fetched once and pinned by hash: FCOS has no package-manager path
    # this design would accept, and the encryptor must exist before the first
    # dump runs. The pin is `settings.AGE_VERSION`, `AGE_URL` and `AGE_SHA256`
    # in scripts/state_backend/settings.py, rendered in below; a custom regex
    # manager in renovate.json5 moves the version there, not here.
    - name: age-install.service
      enabled: true
      contents: |
        [Unit]
        Description=Install the pinned age binary
        After=network-online.target
        Wants=network-online.target
        ConditionPathExists=!/opt/bin/age

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        ExecStart=/usr/bin/bash -c 'set -euo pipefail; \
          tmp=$(mktemp -d); \
          curl -fsSL -o "$tmp/age.tgz" {{ age_url }}; \
          echo "{{ age_sha256 }}  $tmp/age.tgz" | sha256sum -c -; \
          tar -xzf "$tmp/age.tgz" -C "$tmp"; \
          install -m 0755 "$tmp/age/age" /opt/bin/age; \
          rm -rf "$tmp"'

        [Install]
        WantedBy=multi-user.target

    # A `Type=oneshot` unit has no start timeout unless it asks for one, and
    # every step of a dump can hang rather than fail: a `podman exec` whose
    # container has stopped answering waits forever, and so does a socket
    # nothing closes. Untimed, one hang is the last dump this box ever takes,
    # because a timer does not start a service that is still running. The
    # budget is the script's own deadlines -- 120 s for each of the two B2
    # control calls and 600 s for the upload -- plus pg_dump, the listing and
    # age on this shape's single OCPU, so anything past half an hour is a hang
    # and not a slow dump. It is the unit that carries it rather than each
    # subprocess: expiry here kills the whole cgroup, where a deadline inside
    # the script would leave the `podman exec` it gave up on still running.
    #
    # `PrivateTmp=` is deliberately absent, in either of its forms.
    # `disconnected` backs the service's /tmp and /var/tmp with a fresh tmpfs,
    # which on a box with 1 GB of memory is what the spool exists to avoid;
    # plain `yes` leaves the host's disk behind them but gives the service a
    # private pair of its own, so the /var/tmp the script names
    # (state-dump.sh) is no longer the /var/tmp it gets. That spool is a
    # choice about this box's disk, and it is made in one file.
    - name: state-dump.service
      contents: |
        [Unit]
        Description=Dump, encrypt and upload the Pulumi state
        After=pgstate.service age-install.service
        Requires=age-install.service
        OnFailure=state-dump-failed.service

        [Service]
        Type=oneshot
        TimeoutStartSec=30min
        EnvironmentFile=/etc/kluster/state-dump.env
        ExecStart=/usr/local/bin/state-dump
        ExecStartPost=-/usr/bin/rm -f /etc/motd.d/10-state-dump.motd

    # Where a failure goes, and how far it gets. What watches the objects does
    # so from outside, and sees their names and stamps, never why a run failed
    # (`state-backend probe`, state-backend.md §6). So the box's own account
    # of a failure reaches exactly one place: Fedora CoreOS prints
    # /etc/motd.d/* at an interactive ssh login — a plain `state-backend
    # ssh`; one given a command prints none — and that login is how an
    # operator gets there. It pages nobody. What it buys is that a dump which
    # has been failing for a week says so to the next person who opens a
    # shell there for any reason, instead of being a `systemctl status`
    # nobody thought to run.
    # The notice means "the last run failed", which is why a good run removes
    # it: ExecStartPost above does not run when ExecStart failed or was killed
    # by the timeout.
    - name: state-dump-failed.service
      contents: |
        [Unit]
        Description=Leave a failed state dump where the next login will see it

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/bash -c '{ echo "kluster: the last state dump FAILED, so nothing was uploaded for it. Full story: journalctl -u state-dump.service"; journalctl -u state-dump.service -n 20 --no-pager -o short-iso; } > /etc/motd.d/10-state-dump.motd'

    - name: state-dump.timer
      enabled: true
      contents: |
        [Unit]
        Description=Daily Pulumi state dump

        [Timer]
        OnCalendar={{ dump_schedule }}
        RandomizedDelaySec=900
        Persistent=true

        [Install]
        WantedBy=timers.target
