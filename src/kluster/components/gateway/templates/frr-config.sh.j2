#!/bin/sh
# Managed by the {{ cluster }} physical stack. Local edits are overwritten.
#
# Converge the routing daemon's on-state: the protocol daemon switched on in
# the firmware's own daemon list, this program's configuration where the daemon
# reads it, and a restart so the running daemon holds it. Runs at boot from
# frr-config.service, and again as the post-apply hook of the file it installs,
# so the boot path is the path every push exercises.
#
# The daemon's copy and the daemon list are both off /data, so nothing promises
# either across a firmware update; the source below survives one, which is what
# makes this recoverable with nothing else present. A missing source means this
# program no longer declares the configuration -- not that the daemon should
# lose the one it is running on.
#
# What decides "already done" is the stamp, written only after the daemon has
# been restarted onto the configuration. The installed file alone cannot decide
# it: a run whose restart failed leaves the bytes in place, and a rerun that
# trusted them would exit successfully with the daemon still on the old
# configuration. The stamp names the parser as well as the source -- the
# firmware release, and the checksum of the vtysh that parses -- because an
# update may leave the stamp in place and bring a parser that has never read
# the file.
set -eu

source={{ source }}
live={{ live }}
stamp={{ stamp }}
firmware={{ firmware }}
daemons={{ daemons }}

[ -e "$source" ] || exit 0

# Read before anything is touched: a parser this cannot identify is a stamp
# that cannot say which parser it means, and the run fails rather than
# guessing.
release=$(cat "$firmware")
if [ -z "$release" ]; then
    echo "frr-config: $firmware names no release" >&2
    exit 1
fi
parser=$(cksum <"$(command -v {{ parser }})")

# The daemon list is the firmware's own file, which a firmware update may put
# back as it ships, so the toggle is a fact re-checked on every run rather than
# a hand edit. The assertion is why the check is two steps: a list reshaped
# until neither line is in it must fail loudly, instead of passing silently
# over a daemon that will never start.
toggled=0
if grep -qx '{{ daemon }}=no' "$daemons"; then
    echo "frr-config: switching {{ daemon }} on in $daemons"
    sed -i 's/^{{ daemon }}=no$/{{ daemon }}=yes/' "$daemons"
    toggled=1
fi
if ! grep -qx '{{ daemon }}=yes' "$daemons"; then
    echo "frr-config: $daemons carries no {{ daemon }} line this program understands" >&2
    exit 1
fi

applied="$(cksum <"$source") $release $parser"
if [ "$toggled" -eq 0 ] && [ "$applied" = "$(cat "$stamp" 2>/dev/null)" ] && cmp -s "$source" "$live"; then
    exit 0
fi

# Parsed before anything is installed or restarted, against the command tree
# the firmware's own daemons have: a line a newer parser rejects fails the
# converge here, rather than surfacing as a session that never comes up. A
# failure leaves the live copy and the stamp as they were, so the next run
# retries.
echo "frr-config: checking $source"
{{ check }} "$source"

echo "frr-config: installing $live"
# Owner and group are the daemon suite's own convention, and what an operator
# writing the configuration out from the daemon expects to overwrite. They are
# not load-bearing: the supervisor that pushes the file into the daemons keeps
# root and reads it either way.
install -o {{ owner }} -g {{ group }} -m {{ mode }} "$source" "$live"
# A restart, not a reload: the reload path needs a helper this firmware does
# not ship, and the daemon holds no session besides this one to drop.
{{ restart }}
echo "$applied" >"$stamp"
