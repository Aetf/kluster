{#- One upstream as `reverse_proxy` takes it, so that every vhost reaching an
    appliance over its own certificate is written once: the transport, and the
    `Host` line where the upstream requires it. Emitted at the indentation of a
    `handle` body, with no newline of its own at either end. -#}
{%- macro proxy(upstream) -%}
{%- if upstream.self_signed %}
		reverse_proxy {{ upstream.dial }} {
{%- if upstream.pass_host_header %}
			header_up Host {host}
{%- endif %}
			transport http {
				tls_insecure_skip_verify
			}
		}
{%- else %}
		reverse_proxy {{ upstream.dial }}
{%- endif %}
{%- endmacro -%}
{
	email {{ acme_contact }}
	debug
	admin off
}

*.{{ zone }} {
	tls {
		dns cloudflare {file.{{ token_path }}}
	}

	@controller host {{ controller }}
	handle @controller {
{{- proxy(controller_upstream) }}
	}
{%- for service in vhosts %}

	@{{ service.name }} host {{ service.vhost }}
	handle @{{ service.name }} {
		reverse_proxy http://{{ service.address }}:{{ api_port }}
	}
{%- endfor %}

	handle {
		abort
	}
}
{%- if legacy %}

*.{{ legacy_zone }} {
	tls {
		dns cloudflare {file.{{ token_path }}}
	}
{%- for vhost in legacy %}

	@{{ vhost.label }} host {{ vhost.host }}
	handle @{{ vhost.label }} {
{{- proxy(vhost.upstream) }}
	}
{%- endfor %}

	handle {
		abort
	}
}
{%- for vhost in legacy if vhost.bare_name %}

http://{{ vhost.label }} {
	redir https://{{ vhost.host }}{uri} permanent
}
{%- endfor %}
{%- endif %}
