#!/bin/sh
# Managed by the {{ cluster }} physical stack. Local edits are overwritten.
#
# The device read against what the physical stack declares for it: every
# declared machine running, every unit the persistence layer delivers enabled
# and active, the routing daemon running, the overlay member online, an offline
# package cache that would carry an offline boot, the base under the firmware
# being the one the program is written for, and systemd-networkd kept from the
# firmware's policy routing. Nothing on the device
# runs this. The homelab host's daily check runs it over SSH, and an operator
# can run it by hand (physical/gateway.md §1.6).
#
# Read-only. It asks systemd questions and changes nothing: the package script
# runs in its --check mode, which writes nothing, the overlay member is read
# with `zerotier-cli info` in its machine's mount namespace, and networkd's state
# with `ip rule show`, `networkctl list` and `systemd-analyze cat-config`.
#
# A healthy device gives no output and exit status 0. Otherwise it prints one
# line per finding, each naming its playbook in physical/gateway.md §3, and
# exits 1.
#
# With --certificates it reads nothing, and prints one line per certificate the
# declared proxy obtains instead: the proxy's address and one name that
# certificate covers, which is what a probe from the LAN needs.
set -u

usage() {
    echo "usage: $0 [--certificates]" >&2
    exit 2
}

[ $# -le 1 ] || usage
case ${1:-} in
'') ;;
--certificates)
    printf '%s\n'{% for line in certificates %} {{ line }}{% endfor %}
    exit 0
    ;;
*) usage ;;
esac

found=0

# One finding: what is wrong, how it reads, and the playbook it is answered by.
finding() {
    printf '%s: %s — playbook: physical/gateway.md §3, "%s"\n' "$1" "$2" "$3"
    found=1
}

# Lines of output as one line, for a finding: carriage returns dropped, empty
# lines skipped, the rest joined with `sep` (a space unless given).
oneline() {
    awk -v sep="${1:- }" '{ sub(/\r$/, "") } NF { out = out (out == "" ? "" : sep) $0 } END { print out }'
}

# `systemctl is-active` or `is-enabled` on one unit, judged by its exit status,
# which is how systemd means it. The word it printed is what a finding reports;
# a unit it has no file for prints nothing on stdout and is reported by status.
ask() {
    answer=$(systemctl "$1" "$2" 2>/dev/null)
    status=$?
    answer=${answer:-"no answer (exit $status)"}
    return $status
}

# The machines, from the declaration rather than from /etc/systemd/nspawn: a
# firmware update that does not carry /etc across removes exactly those
# settings files, and a list read off them would be empty in the case this
# reading exists for.
for unit in{% for unit in machine_units %} {{ unit }}{% endfor %}; do
    ask is-active "$unit" || finding "$unit" "$answer" {{ playbooks.machine }}
done

# The overlay member, read only while its machine runs: a machine that is down
# is the finding above, and asking inside it would report the same fault twice.
# The machine runs s6-overlay, with no systemd and no bus, so `machinectl
# shell` cannot start a command in it: machined asks the guest's own systemd for
# that. The client runs in the mount namespace of the machine's leader instead,
# which holds the daemon's state and token; the member shares the host's
# network, so the daemon's local port is reachable as it is. Its lines are
# joined into one, as everything a finding quotes is. `TUNNELED` is a member
# that reaches its roots only over ZeroTier's TCP relay, and is online too.
if ask is-active {{ overlay_unit }}; then
    info=$( { leader=$(machinectl show --property=Leader --value {{ overlay_machine }}) &&
        nsenter --target "$leader" --mount -- {{ zerotier_cli }} info; } </dev/null 2>&1 | oneline)
    case " $info " in
    *' ONLINE '* | *' TUNNELED '*) ;;
    *) finding {{ overlay_machine }} "zerotier-cli info: ${info:-no answer}" {{ playbooks.overlay }} ;;
    esac
fi

# Every unit the persistence layer delivers is enabled and active. Each oneshot
# among them keeps its success as `active`, so a failed run reads as not active.
# The boot chain's anchor not active is its last run having failed, which has a
# playbook of its own.
for unit in{% for unit in units %} {{ unit }}{% endfor %}; do
    wrong=
    title={{ playbooks.unit }}
    ask is-enabled "$unit" || wrong=$answer
    if ! ask is-active "$unit"; then
        wrong=${wrong:+$wrong, }$answer
        if [ "$unit" = {{ boot_chain_unit }} ]; then
            title={{ playbooks.boot_chain }}
        fi
    fi
    [ -z "$wrong" ] || finding "$unit" "$wrong" "$title"
done

# The routing daemon. Nothing enables its unit, so only whether it runs is read.
ask is-active {{ routing_daemon }} || finding {{ routing_daemon }} "$answer" {{ playbooks.routing }}

# networkd and the firmware's policy routing, read three ways. networkd under
# its defaults removes every policy rule it did not create from a link it
# configures, and the firmware's rules are such rules.
#
# The consequence: a rule that looks up the main table, which the gateway's own
# packets are routed by. With it gone the gateway cannot route its replies, so
# no reading run over SSH reports its absence; this one serves an operator who
# runs it at the device after a controller apply, as its playbook says.
for family in{% for family in rule_families %} {{ family }}{% endfor %}; do
    rules=$(ip -"$family" rule show 2>/dev/null)
    status=$?
    if [ "$status" -ne 0 ]; then
        finding "ip -$family rule" "no answer (exit $status)" {{ playbooks.networkd }}
    elif ! printf '%s\n' "$rules" | awk -v table={{ main_table }} '
        { for (i = 1; i < NF; i++) if ($i == "lookup" && $(i + 1) == table) found = 1 }
        END { exit !found }'; then
        finding "ip -$family rule" "holds no rule that looks up "{{ main_table }} {{ playbooks.networkd }}
    fi
done

# The trigger: a link networkd manages, which is a link whose every
# reconfiguration runs that removal. None is the declared state, since the
# machines' ports are marked unmanaged. A networkd that is not running manages
# nothing, and is not asked.
if ask is-active {{ networkd_unit }}; then
    links=$(networkctl list --no-legend --no-pager 2>/dev/null)
    status=$?
    if [ "$status" -ne 0 ]; then
        finding networkctl "list gave no answer (exit $status)" {{ playbooks.networkd }}
    else
        managed=$(printf '%s\n' "$links" | awk 'NF >= 5 && $5 != "unmanaged" { print $2 "=" $5 }')
        for link in $managed; do
            finding "${link%%=*}" "networkd's setup state is ${link#*=}, not unmanaged" {{ playbooks.networkd }}
        done
    fi
fi

# The guard: every option the declared drop-in sets reads as declared in
# networkd's configuration as systemd-analyze assembles it, the main file and
# the drop-ins in the order networkd applies them, so a later-sorted file that
# turns one back on is a finding. Within the section, the last assignment
# that parses as a boolean wins, read the ways systemd parses one; an
# assignment that does not parse, an empty one included, is ignored and the
# earlier value stands, as networkd's own parser does. An option no assignment
# sets is at networkd's default. This is what the disk says: nothing reports what the
# running daemon loaded, which is why the boot chain restarts networkd on every
# change.
config=$(systemd-analyze --no-pager cat-config {{ networkd_config }} 2>/dev/null)
status=$?
if [ "$status" -ne 0 ]; then
    finding systemd-analyze "cat-config "{{ networkd_config }}" gave no answer (exit $status)" {{ playbooks.networkd }}
else
    for setting in{% for setting in networkd_settings %} {{ setting }}{% endfor %}; do
        option=${setting%%=*}
        want=${setting#*=}
        have=$(printf '%s\n' "$config" | awk -v section={{ networkd_section }} -v option="$option" '
            { sub(/\r$/, ""); line = $0; sub(/^[ \t]+/, "", line) }
            line == "" || line ~ /^[#;]/ { next }
            line ~ /^\[/ { current = substr(line, 2, index(line, "]") - 2); next }
            current == section && index(line, "=") {
                key = substr(line, 1, index(line, "=") - 1)
                sub(/[ \t]+$/, "", key)
                if (key != option) next
                value = substr(line, index(line, "=") + 1)
                sub(/^[ \t]+/, "", value)
                sub(/[ \t]+$/, "", value)
                folded = tolower(value)
                if (folded ~ /^(1|yes|y|true|t|on)$/) last = "yes"
                else if (folded ~ /^(0|no|n|false|f|off)$/) last = "no"
            }
            END { print last }')
        case $have in
        "$want") ;;
        '') finding "$option" "unset in "{{ networkd_config }}", so networkd's default applies, not $want" {{ playbooks.networkd }} ;;
        *) finding "$option" "reads $have in "{{ networkd_config }}", not $want" {{ playbooks.networkd }} ;;
        esac
    done
fi

# The offline cache, judged by the package script itself, whose reasons become
# one finding.
reasons=$({{ packages_script }} --check 2>&1)
status=$?
if [ "$status" -ne 0 ]; then
    reasons=$(printf '%s\n' "$reasons" | sed 's/^packages: //' | oneline '; ')
    finding {{ packages_check }} "${reasons:-exit $status, and no reason given}" {{ playbooks.packages }}
fi

# The base under the firmware, read against the one the program is written for:
# the Debian release, what `/bin/sh` resolves to, and which side of systemd
# {{ systemd_release }} the device is on. The firmware's own release is not read, since one
# that keeps the base moves nothing these facts decide, and a point release is
# not compared either: the release is the major one `/etc/debian_version`
# starts with. The paths are read under the tree's root, which is empty on the
# device, and the shell `/bin/sh` resolves to is compared with that root taken
# off its front.
debian=$(cat {{ debian_version }} 2>/dev/null | oneline)
[ "${debian%%.*}" = {{ debian_release }} ] ||
    finding /etc/debian_version "reads ${debian:-nothing}, not Debian "{{ debian_release }} {{ playbooks.base }}

shell=$(readlink -f {{ bin_sh }} 2>/dev/null)
shell=${shell#{{ root }}}
[ "$shell" = {{ shell }} ] ||
    finding /bin/sh "resolves to ${shell:-nothing}, not "{{ shell }} {{ playbooks.base }}

systemd=$(systemctl --version 2>/dev/null | awk 'NR == 1 && $1 == "systemd" { print $2 }')
case $systemd in
'' | *[!0-9]*)
    finding systemd "systemctl --version names no release" {{ playbooks.base }}
    ;;
*)
{%- if terminate_signals_nspawn %}
    [ "$systemd" -ge {{ systemd_release }} ] ||
        finding systemd "systemd $systemd, not {{ systemd_release }} or later" {{ playbooks.base }}
{%- else %}
    [ "$systemd" -lt {{ systemd_release }} ] ||
        finding systemd "systemd $systemd, not below {{ systemd_release }}" {{ playbooks.base }}
{%- endif %}
    ;;
esac

exit "$found"
