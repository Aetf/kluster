#!/bin/sh
# Managed by the {{ cluster }} physical stack. Local edits are overwritten.
#
# The device read against what the physical stack declares for it: every
# declared machine running, every machine on a bridge attached to it, every
# unit the persistence layer delivers enabled
# and active, the BGP daemon holding the declared peer, every network on the
# site's delegated prefix on the /64 the last run read for it, the PD
# lease naming that /64, the controller's UPnP answering the networks the
# census names and no other, the overlay member online, an offline
# package cache that would carry an offline boot, the base under the firmware
# being the one the program is written for, and systemd-networkd kept from the
# firmware's policy routing. Nothing on the device
# runs this. The homelab host's daily check runs it over SSH, and an operator
# can run it by hand (physical/gateway.md §1.6).
#
# Read-only. It asks systemd questions and changes nothing: the package script
# runs in its --check mode, which writes nothing, the overlay member is read
# with `zerotier-cli info` in its machine's mount namespace, a machine's port with
# `ip link show` in its machine's network namespace and in the device's, the
# BGP daemon with `vtysh -c 'show bgp neighbors <peer> json'`, a bridge's
# addresses with `ip -6 -o addr show`, the PD lease with `awk`, the networks
# that opt in to UPnP with a `find` through the controller's own database
# client, the dash package with `dpkg-query -W`, and networkd's state with
# `ip rule show`, `networkctl list` and `systemd-analyze cat-config`.
#
# A healthy device gives no output and exit status 0. Otherwise it prints one
# line per finding, each naming its playbook in physical/gateway.md §3, and
# exits 1.
#
# With --certificates it reads nothing, and prints one line per certificate the
# declared proxy obtains instead: the proxy's address and one name that
# certificate covers, which is what a probe from the LAN needs.
set -u

usage() {
    echo "usage: $0 [--certificates]" >&2
    exit 2
}

[ $# -le 1 ] || usage
case ${1:-} in
'') ;;
--certificates)
    printf '%s\n'{% for line in certificates %} {{ line }}{% endfor %}
    exit 0
    ;;
*) usage ;;
esac

found=0

# One finding: what is wrong, how it reads, and the playbook it is answered by.
finding() {
    printf '%s: %s — playbook: physical/gateway.md §3, "%s"\n' "$1" "$2" "$3"
    found=1
}

# Lines of output as one line, for a finding: carriage returns dropped, empty
# lines skipped, the rest joined with `sep` (a space unless given).
oneline() {
    awk -v sep="${1:- }" '{ sub(/\r$/, "") } NF { out = out (out == "" ? "" : sep) $0 } END { print out }'
}

# A command run with no input, its standard output left in `out`, its
# standard error in `err` and its exit status in `status`, so that what is
# parsed is the answer alone and what a finding quotes is everything the
# command said. Each line is tagged with the stream it came from on the way out
# of the subshell, the status is written beside them on a tag of its own, and
# the tags sorted back.
apart() {
    both=$( { { { "$@" </dev/null; printf 's %s\n' "$?" >&3; } | sed 's/^/o /'; } 2>&1 1>&3 | sed 's/^/e /'; } 3>&1)
    out=$(printf '%s\n' "$both" | sed -n 's/^o //p')
    err=$(printf '%s\n' "$both" | sed -n 's/^e //p')
    status=$(printf '%s\n' "$both" | sed -n 's/^s //p')
}

# `systemctl is-active` or `is-enabled` on one unit, judged by its exit status,
# which is how systemd means it. The word it printed is what a finding reports;
# a unit it has no file for prints nothing on stdout and is reported by status.
ask() {
    answer=$(systemctl "$1" "$2" 2>/dev/null)
    status=$?
    answer=${answer:-"no answer (exit $status)"}
    return $status
}

# The machines, from the declaration rather than from /etc/systemd/nspawn: a
# firmware update that does not carry /etc across removes exactly those
# settings files, and a list read off them would be empty in the case this
# reading exists for.
for unit in{% for unit in machine_units %} {{ unit }}{% endfor %}; do
    ask is-active "$unit" || finding "$unit" "$answer" {{ playbooks.machine }}
done

# The overlay member, read only while its machine runs: a machine that is down
# is the finding above, and asking inside it would report the same fault twice.
# The machine runs s6-overlay, with no systemd and no bus, so `machinectl
# shell` cannot start a command in it: machined asks the guest's own systemd for
# that. The client runs in the mount namespace of the machine's leader instead,
# which holds the daemon's state and token; the member shares the host's
# network, so the daemon's local port is reachable as it is. Its lines are
# joined into one, as everything a finding quotes is. `TUNNELED` is a member
# that reaches its roots only over ZeroTier's TCP relay, and is online too.
if ask is-active {{ overlay_unit }}; then
    info=$( { leader=$(machinectl show --property=Leader --value {{ overlay_machine }}) &&
        nsenter --target "$leader" --mount -- {{ zerotier_cli }} info; } </dev/null 2>&1 | oneline)
    case " $info " in
    *' ONLINE '* | *' TUNNELED '*) ;;
    *) finding {{ overlay_machine }} "zerotier-cli info: ${info:-no answer}" {{ playbooks.overlay }} ;;
    esac
fi

# Every machine on a bridge has its port there: the host end of the pair nspawn
# made for it has that bridge as its master. nspawn sets the master at the
# machine's start and the bridge watchdog restores one a port lost, and a port
# without it is a state systemd has no view of, the machine and the bridge both
# being up. The port is found from the machine's own end of the pair, `host0`,
# whose peer index `ip -o link show` prints in the leader's network namespace,
# and not by its name: nspawn names it `vb-` and the machine's name, shortened
# with a hash where that is longer than an interface name may be. A machine
# that is down is the finding above, and is not asked.
attachment() {
    machine=$2
    bridge=$3
    ask is-active "$1" || return 0
    apart machinectl show --property=Leader --value "$machine"
    leader=$out
    if [ -z "$leader" ]; then
        said=$(printf '%s\n' "$err" | oneline)
        finding "$machine" "machinectl names no leader: ${said:-no answer}" {{ playbooks.port }}
        return 0
    fi
    apart nsenter --target "$leader" --net -- ip -o link show host0
    index=$(printf '%s\n' "$out" | sed -n 's/^[0-9][0-9]*: host0@if\([0-9][0-9]*\):.*/\1/p')
    if [ -z "$index" ]; then
        said=$(printf '%s\n' "$out" "$err" | oneline)
        finding "$machine" "host0 names no port: ${said:-no answer}" {{ playbooks.port }}
        return 0
    fi
    # The device's links, which hold its loopback at least: a list with
    # nothing in it is a listing that failed.
    apart ip -o link show
    if [ -z "$out" ]; then
        said=$(printf '%s\n' "$err" | oneline)
        finding "$machine" "ip -o link show listed nothing: ${said:-no answer}" {{ playbooks.port }}
        return 0
    fi
    port=$(printf '%s\n' "$out" | awk -v want="$index:" '
        $1 == want {
            name = $2
            sub(/@.*/, "", name)
            sub(/:$/, "", name)
            master = ""
            for (i = 3; i < NF; i++) if ($i == "master") master = $(i + 1)
            print name " " master
            exit
        }')
    name=${port%% *}
    master=${port#* }
    if [ -z "$port" ]; then
        finding "$machine" "its port, link $index, is not among the device's links" {{ playbooks.port }}
    elif [ -z "$master" ]; then
        finding "$machine" "port $name has no master, not $bridge" {{ playbooks.port }}
    elif [ "$master" != "$bridge" ]; then
        finding "$machine" "port $name has master $master, not $bridge" {{ playbooks.port }}
    fi
}
{% for machine in bridged_machines %}
attachment {{ machine }}
{%- endfor %}

# Every unit the persistence layer delivers is enabled and active. Each oneshot
# among them keeps its success as `active`, so a failed run reads as not active.
# The boot chain's anchor not active is its last run having failed, which has a
# playbook of its own.
for unit in{% for unit in units %} {{ unit }}{% endfor %}; do
    wrong=
    title={{ playbooks.unit }}
    ask is-enabled "$unit" || wrong=$answer
    if ! ask is-active "$unit"; then
        wrong=${wrong:+$wrong, }$answer
        if [ "$unit" = {{ boot_chain_unit }} ]; then
            title={{ playbooks.boot_chain }}
        fi
    fi
    [ -z "$wrong" ] || finding "$unit" "$wrong" "$title"
done

# The BGP daemon, read by what it answers: the firmware runs the routing suite as
# the controller's children and ships no unit for it, so no unit's state says
# anything about it. It answers for the declared peer, and names that peer at the
# declared remote AS, which proves the controller's configuration accepted; the
# session's state is not read, since it stays down until the worker peers. The
# remote AS is the one key `remoteAs` of the peer's own object, found by
# walking the answer's braces and strings rather than by matching a line, so a
# key of that name in an object nested inside it is not the one read.
if ! command -v {{ vtysh }} >/dev/null 2>&1; then
    finding {{ peer }} {{ vtysh }}" is not on the device's PATH" {{ playbooks.routing }}
else
    neighbor=$({{ vtysh }} -c "show bgp neighbors "{{ peer }}" json" </dev/null 2>&1)
    status=$?
    if [ "$status" -ne 0 ]; then
        said=$(printf '%s\n' "$neighbor" | oneline)
        finding {{ peer }} {{ vtysh }}" answered ${said:-nothing} (exit $status)" {{ playbooks.routing }}
    else
        remote=$(printf '%s\n' "$neighbor" | awk -v peer={{ peer }} '
            { text = text $0 "\n" }
            END {
                n = length(text); depth = 0; key = ""; last = ""; held = 0; within = 0
                for (i = 1; i <= n; i++) {
                    c = substr(text, i, 1)
                    if (c == "\"") {
                        s = ""
                        for (i++; i <= n && (c = substr(text, i, 1)) != "\""; i++) {
                            if (c == "\\") { i++; c = substr(text, i, 1) }
                            s = s c
                        }
                        last = s
                    } else if (c == ":") {
                        key = last
                        if (within && depth == 2 && key == "remoteAs") {
                            value = substr(text, i + 1)
                            sub(/^[ \t\n]+/, "", value)
                            if (match(value, /^[0-9]+/)) { print substr(value, 1, RLENGTH); exit }
                            print "-"; exit
                        }
                    } else if (c == "{") {
                        depth++
                        if (depth == 2 && key == peer) { held = 1; within = 1 }
                    } else if (c == "}") {
                        if (depth == 2) within = 0
                        depth--
                    }
                }
                if (held) print "-"
            }')
        case $remote in
        '') finding {{ peer }} "the BGP daemon holds no such neighbor" {{ playbooks.routing }} ;;
        -) finding {{ peer }} "the BGP daemon names no remote AS for it" {{ playbooks.routing }} ;;
        {{ peer_asn }}) ;;
        *) finding {{ peer }} "neighbor at remote AS $remote, not "{{ peer_asn }} {{ playbooks.routing }} ;;
        esac
    fi
fi

# Every network on the site's delegated prefix, by its bridge: the bridge holds
# the gateway's address on the /64 the last run read for it. A bridge that
# holds another is a prefix the ISP moved since that run, or the bridge
# numbered anew by the firmware under the same prefix; the lease, which the
# finding's playbook reads, tells the two apart. While the
# bridge holds it, the PD lease's line for the bridge on the WAN names the
# same /64 in the shape the program's read knows, six fields with integer
# lifetimes: a lease that does not is a format the program's read would
# refuse, read here first.
delegation() {
    bridge=$1
    address=$2
    subnet=$3
    apart ip -6 -o addr show dev "$bridge" scope global
    if ! printf '%s\n' "$out" | awk -v want="$address" '
        { for (i = 1; i < NF; i++) if ($i == "inet6" && $(i + 1) == want) found = 1 }
        END { exit !found }'; then
        held=$(printf '%s\n' "$out" | awk '{ for (i = 1; i < NF; i++) if ($i == "inet6") print $(i + 1) }' | oneline)
        if [ -z "$held" ]; then
            said=$(printf '%s\n' "$err" | oneline)
            held="no global address${said:+ ($said)}"
        fi
        finding "$bridge" "holds $held, not $address" {{ playbooks.prefix }}
        return 0
    fi
    if [ ! -f {{ pd_leases }} ]; then
        finding "$bridge" {{ pd_leases }}" is missing" {{ playbooks.lease }}
        return 0
    fi
    line=$(awk -v wan={{ pd_wan }} -v bridge="$bridge" '$1 == wan && $2 == bridge { print; exit }' {{ pd_leases }} | oneline)
    if [ -z "$line" ]; then
        finding "$bridge" {{ pd_leases }}" holds no line for it on "{{ pd_wan }} {{ playbooks.lease }}
    elif ! printf '%s\n' "$line" | awk -v want="$subnet" '
        NF == 6 && $4 == want && $5 ~ /^[0-9]+$/ && $6 ~ /^[0-9]+$/ { found = 1 }
        END { exit !found }'; then
        finding "$bridge" {{ pd_leases }}" reads '$line', not $subnet" {{ playbooks.lease }}
    fi
}
{% for delegation in delegations %}
delegation {{ delegation }}
{%- endfor %}

# The networks the controller's UPnP and NAT-PMP service answers are the ones
# whose network object opts in, read off the controller's database: the ones
# the census's port-mapping row names, no more and no fewer. The server LAN's
# opt-in is set in the console, and this reading is what holds it to the row,
# part of the layer physical/gateway.md §4.2 rule 8 lists, removed whole once
# the census declares the opt-in. Standard output alone is parsed; what the
# client writes to standard error is quoted only when it fails. Each network is
# compared by the subnet it
# holds, which the controller spells as the gateway's address and the prefix
# and the row as the network's own, so each is taken to its network address
# first.
apart {{ upnp_read }}
if [ "$status" -ne 0 ]; then
    said=$(printf '%s\n' "$out" "$err" | oneline)
    finding networkconf "the controller's database answered ${said:-nothing} (exit $status)" {{ playbooks.upnp }}
else
    served=$(printf '%s\n' "$out" | awk -F '\t' '
        NF == 0 { next }
        {
            split($1, cidr, "/")
            if (split(cidr[1], octet, ".") != 4 || cidr[2] !~ /^[0-9]+$/) { print "no subnet\t" $2; next }
            address = ((octet[1] * 256 + octet[2]) * 256 + octet[3]) * 256 + octet[4]
            size = 2 ^ (32 - cidr[2])
            network = address - address % size
            printf "%d.%d.%d.%d/%d\t%s\n", int(network / 16777216), int(network / 65536) % 256,
                int(network / 256) % 256, network % 256, cidr[2], $2
        }')
    for want in{% for subnet in upnp_subnets %} {{ subnet }}{% endfor %}; do
        printf '%s\n' "$served" | awk -F '\t' -v want="$want" '$1 == want { found = 1 } END { exit !found }' ||
            finding "$want" "its network does not opt in to UPnP" {{ playbooks.upnp }}
    done
    others=$(printf '%s\n' "$served" | awk -F '\t' -v wanted=" "{{ upnp_wanted }}" " 'NF && !index(wanted, " " $1 " ")')
    while IFS='	' read -r subnet name; do
        [ -z "$subnet" ] || finding "$subnet" "$name opts in to UPnP, and rule 8 does not name it" {{ playbooks.upnp }}
    done <<EOF
$others
EOF
fi

# networkd and the firmware's policy routing, read three ways. networkd under
# its defaults removes every policy rule it did not create from a link it
# configures, and the firmware's rules are such rules.
#
# The consequence: a rule that looks up the main table, which the gateway's own
# packets are routed by. With it gone the gateway cannot route its replies, so
# no reading run over SSH reports its absence; this one serves an operator who
# runs it at the device after a controller apply, as its playbook says.
for family in{% for family in rule_families %} {{ family }}{% endfor %}; do
    rules=$(ip -"$family" rule show 2>/dev/null)
    status=$?
    if [ "$status" -ne 0 ]; then
        finding "ip -$family rule" "no answer (exit $status)" {{ playbooks.networkd }}
    elif ! printf '%s\n' "$rules" | awk -v table={{ main_table }} '
        { for (i = 1; i < NF; i++) if ($i == "lookup" && $(i + 1) == table) found = 1 }
        END { exit !found }'; then
        finding "ip -$family rule" "holds no rule that looks up "{{ main_table }} {{ playbooks.networkd }}
    fi
done

# The trigger: a link networkd manages, which is a link whose every
# reconfiguration runs that removal. None is the declared state, since the
# machines' ports are marked unmanaged. A networkd that is not running manages
# nothing, and is not asked.
if ask is-active {{ networkd_unit }}; then
    links=$(networkctl list --no-legend --no-pager 2>/dev/null)
    status=$?
    if [ "$status" -ne 0 ]; then
        finding networkctl "list gave no answer (exit $status)" {{ playbooks.networkd }}
    else
        managed=$(printf '%s\n' "$links" | awk 'NF >= 5 && $5 != "unmanaged" { print $2 "=" $5 }')
        for link in $managed; do
            finding "${link%%=*}" "networkd's setup state is ${link#*=}, not unmanaged" {{ playbooks.networkd }}
        done
    fi
fi

# The guard: every option the declared drop-in sets reads as declared in
# networkd's configuration as systemd-analyze assembles it, the main file and
# the drop-ins in the order networkd applies them, so a later-sorted file that
# turns one back on is a finding. Within the section, the last assignment
# that parses as a boolean wins, read the ways systemd parses one; an
# assignment that does not parse, an empty one included, is ignored and the
# earlier value stands, as networkd's own parser does. An option no assignment
# sets is at networkd's default. This is what the disk says: nothing reports what the
# running daemon loaded, which is why the boot chain restarts networkd on every
# change.
config=$(systemd-analyze --no-pager cat-config {{ networkd_config }} 2>/dev/null)
status=$?
if [ "$status" -ne 0 ]; then
    finding systemd-analyze "cat-config "{{ networkd_config }}" gave no answer (exit $status)" {{ playbooks.networkd }}
else
    for setting in{% for setting in networkd_settings %} {{ setting }}{% endfor %}; do
        option=${setting%%=*}
        want=${setting#*=}
        have=$(printf '%s\n' "$config" | awk -v section={{ networkd_section }} -v option="$option" '
            { sub(/\r$/, ""); line = $0; sub(/^[ \t]+/, "", line) }
            line == "" || line ~ /^[#;]/ { next }
            line ~ /^\[/ { current = substr(line, 2, index(line, "]") - 2); next }
            current == section && index(line, "=") {
                key = substr(line, 1, index(line, "=") - 1)
                sub(/[ \t]+$/, "", key)
                if (key != option) next
                value = substr(line, index(line, "=") + 1)
                sub(/^[ \t]+/, "", value)
                sub(/[ \t]+$/, "", value)
                folded = tolower(value)
                if (folded ~ /^(1|yes|y|true|t|on)$/) last = "yes"
                else if (folded ~ /^(0|no|n|false|f|off)$/) last = "no"
            }
            END { print last }')
        case $have in
        "$want") ;;
        '') finding "$option" "unset in "{{ networkd_config }}", so networkd's default applies, not $want" {{ playbooks.networkd }} ;;
        *) finding "$option" "reads $have in "{{ networkd_config }}", not $want" {{ playbooks.networkd }} ;;
        esac
    done
fi

# The offline cache, judged by the package script itself, whose reasons become
# one finding.
reasons=$({{ packages_script }} --check 2>&1)
status=$?
if [ "$status" -ne 0 ]; then
    reasons=$(printf '%s\n' "$reasons" | sed 's/^packages: //' | oneline '; ')
    finding {{ packages_check }} "${reasons:-exit $status, and no reason given}" {{ playbooks.packages }}
fi

# The base under the firmware, read against the one the program is written for:
# the Debian release, the version of the dash package, what `/bin/sh` resolves
# to, and which side of systemd {{ systemd_release }} the device is on. The firmware's own
# release is not read, since one that keeps the base moves nothing these facts
# decide, and a point release is not compared either: the release is the major
# one `/etc/debian_version` starts with. The dash package is compared whole,
# Debian revision included, because the suite runs the device's scripts under
# that package's own build, and a revision can change what a script may say.
# The paths are read under the tree's root, which is empty on the device, and
# the shell `/bin/sh` resolves to is compared with that root taken off its
# front.
debian=$(cat {{ debian_version }} 2>/dev/null | oneline)
[ "${debian%%.*}" = {{ debian_release }} ] ||
    finding /etc/debian_version "reads ${debian:-nothing}, not Debian "{{ debian_release }} {{ playbooks.base }}

dash=$(dpkg-query -W -f '${Version}' dash 2>/dev/null)
[ "$dash" = {{ dash_version }} ] ||
    finding dash "dpkg-query gives ${dash:-no version}, not "{{ dash_version }} {{ playbooks.base }}

shell=$(readlink -f {{ bin_sh }} 2>/dev/null)
shell=${shell#{{ root }}}
[ "$shell" = {{ shell }} ] ||
    finding /bin/sh "resolves to ${shell:-nothing}, not "{{ shell }} {{ playbooks.base }}

systemd=$(systemctl --version 2>/dev/null | awk 'NR == 1 && $1 == "systemd" { print $2 }')
case $systemd in
'' | *[!0-9]*)
    finding systemd "systemctl --version names no release" {{ playbooks.base }}
    ;;
*)
{%- if terminate_signals_nspawn %}
    [ "$systemd" -ge {{ systemd_release }} ] ||
        finding systemd "systemd $systemd, not {{ systemd_release }} or later" {{ playbooks.base }}
{%- else %}
    [ "$systemd" -lt {{ systemd_release }} ] ||
        finding systemd "systemd $systemd, not below {{ systemd_release }}" {{ playbooks.base }}
{%- endif %}
    ;;
esac

exit "$found"
