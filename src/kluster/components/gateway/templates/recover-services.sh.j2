#!/bin/sh
# Managed by the {{ cluster }} physical stack. Local edits are overwritten.
#
# Re-establishes the container services and the routing configuration from the
# desired state under {{ data_root }}. Runs at boot, when nothing else is present, and
# again after every deployment, so the recovery path is never the untested one.
set -eu

UNITS={{ unit_dir }}
SYSTEMD=/etc/systemd/system
STATE={{ state_dir }}
DECLARED="{{ units | map(attribute='name') | join(' ') }}"

# The stamped set: every file that defines a service. The content stamp below
# is a checksum over exactly these, which is how a restart is decided without
# asking the service anything about itself.
stamped_set() {
    case "$1" in
{%- for unit in units %}
        {{ unit.name }}) stamped="{{ unit.stamped | join(' ') }}" ;;
{%- endfor %}
        *) stamped="" ;;
    esac
    echo "$stamped"
}

# Place a service's own configuration where nothing put one. Whatever is
# already there belongs to the software that wrote it -- the resolvers' rewrites
# arrive through their API and land in this very file -- so an existing file is
# never touched.
install_initial_state() {
    source=""
    destination=""
    case "$1" in
{%- for unit in units if unit.initial_state %}
        {{ unit.name }}) source={{ unit.initial_state.source }}; destination={{ unit.initial_state.destination }} ;;
{%- else %}
        # no service on this device owns its own configuration
{%- endfor %}
    esac
    [ -n "$destination" ] || return 0
    [ -e "$source" ] || return 0
    if [ -e "$destination" ]; then
        return 0
    fi
    mkdir -p "$(dirname "$destination")"
    cp "$source" "$destination"
}

install -d "$SYSTEMD" "$STATE"

# What is declared *and* has landed. A deployment writes this script before the
# files it describes, so a service whose unit or root filesystem tree is still
# missing is one this run has nothing to do about -- not an error, and not a
# reason to leave the rest unconverged.
READY=""
for unit in $DECLARED; do
    [ -e "$UNITS/$unit" ] || continue
    machine=${unit#{{ unit_prefix }}}
    [ -d "{{ root_dir }}/${machine%.service}" ] || continue
    install -m {{ config_mode }} "$UNITS/$unit" "$SYSTEMD/$unit"
    READY="$READY $unit"
done

# Retire what is not declared at all. Only this program's own units are
# candidates: the device has plenty of others and none of them are ours.
for live in "$SYSTEMD/{{ unit_prefix }}"*.service; do
    [ -e "$live" ] || continue
    name=$(basename "$live")
    case " $DECLARED " in
        *" $name "*) continue ;;
    esac
    systemctl disable --now "$name" || true
    rm -f "$live"
    rm -f "$STATE/$name.stamp"
done

# The routing daemon reads outside {{ data_root }}, so its configuration is copied
# rather than linked; a device that lost it in an update gets it back here.
if [ -e {{ frr_config }} ]; then
    install -m {{ frr_mode }} {{ frr_config }} {{ frr_live_config }}
    systemctl reload frr || systemctl restart frr || true
fi

systemctl daemon-reload

# Start what changed, in an order that leaves the service carrying this session
# for last.
for unit in $READY; do
    systemctl enable "$unit" >/dev/null 2>&1 || true
    install_initial_state "$unit"
    stamp="$STATE/$unit.stamp"
    want=$(cat $(stamped_set "$unit") 2>/dev/null | cksum)
    have=$(cat "$stamp" 2>/dev/null || echo none)
    if [ "$want" = "$have" ] && systemctl is-active --quiet "$unit"; then
        continue
    fi
    systemctl restart "$unit"
    echo "$want" > "$stamp"
done
