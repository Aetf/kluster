[Unit]
Description={{ cluster }} estate container {{ name }}
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
{# The command line, one argument per line here and one line in the unit.
   `--boot` looks for an init and finds the one the image places at
   `/sbin/init`, which is s6's. That init never sends a readiness message, so
   nspawn answers for it and `--notify-ready=no` makes the unit ready once the
   container's PID 1 exists; `Type=notify` above is about nspawn's own message,
   not the guest's, and asked to wait for the guest instead every member would
   hang until its start timed out. A member's `/etc/resolv.conf` is the image's
   answer to a question it was built with -- the member carrying the overlay
   resolves through public servers because it has to come up while this
   estate's own resolvers are down -- so nothing overwrites it. And every image
   configures its own interface from inside, which takes the one capability
   nspawn's default set does not keep.

   The root is a directory rather than a filesystem image because that is the
   shape the pins arrive in: the artifacts are root filesystem tarballs, and
   `--image=` boots a partitioned or filesystem image, not an archive.

   Host networking is the *absence* of a bridge argument: nspawn shares the
   host's network namespace unless told otherwise, which is why the overlay
   member is described by having no address rather than by a switch.

   `--setenv` is how an image is told anything at all. The unit's own
   `Environment=` would not do: that is the environment of the nspawn process
   on the device, and what has to be set is the environment of PID 1 inside the
   container, which is what the images' s6 startup scripts read.
-#}
ExecStart=/usr/bin/systemd-nspawn --quiet --keep-unit --boot --notify-ready=no --resolv-conf=off --capability=CAP_NET_ADMIN --kill-signal={{ kill_signal }} --machine={{ name }} --directory={{ root }} --setenv=S6_KILL_GRACETIME={{ kill_gracetime }}
{%- for variable, value in environment.items() %} --setenv={{ variable }}={{ value }}{% endfor %}
{%- if bridge %} --network-bridge={{ bridge }}{% endif %}
{%- if state_bind %} --bind={{ state_bind }}{% endif %}
{%- for device in devices %} --bind={{ device }}{% endfor %}
{%- for bind in binds %} --bind-ro={{ bind }}{% endfor %}
Restart=always
RestartSec=5
KillMode=mixed
{#- A bind alone does not grant access to a device node; the unit's own
    control-group policy has to admit it as well, or the container sees the
    file and cannot open it. Naming any device at all is what turns that policy
    from open into a list, so the list also has to carry what a container needs
    anyway: its console is a pseudo-terminal, and pseudo-terminals are not in
    the small set every service gets. #}
{%- for device in devices %}
DeviceAllow={{ device }} rw
{%- endfor %}
{%- if devices %}
DeviceAllow=char-pts rw
{%- endif %}

[Install]
WantedBy=multi-user.target
