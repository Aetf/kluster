# Managed by the {{ cluster }} physical stack. Local edits are overwritten.
#
# What systemd-nspawn@.service -- systemd's own template unit, shared by every
# machine on this device -- cannot say about {{ machine }} in particular.
{%- if bridge_device %}

[Unit]
# Ordered after the bridge's device unit, which holds this machine's start
# behind a bridge systemd is bringing up in the same transaction. systemd has
# such a unit for every network device udev tags, which it does by default; a
# device node gets none, which is why /dev/net/tun is asserted with a bind
# instead.
#
# Ordering alone, and no BindsTo= on the same unit: a binding would stop this
# machine when its bridge went away and nothing would start it back up, because
# a dependency stop forbids the Restart= below from acting. What a bridge that
# is absent costs instead is a start that fails and is retried until the bridge
# is there.
After={{ bridge_device }}
{%- endif %}

[Service]
# The template unit carries no restart policy, so without this a machine that
# died would stay down until the next boot or the next push converged it.
# `always` rather than `on-failure`: a container that exited cleanly is still a
# service that is meant to be running.
#
# A machine that cannot start retries every five seconds for as long as it is
# left alone. Two starts in any ten seconds stay inside systemd's default start
# rate limit, so nothing here ever gives up: `systemctl stop` ends the loop, and
# so does `machinectl terminate` on the systemd this device runs -- 247, the
# reading physical/gateway.md §1 records -- because `--keep-unit` makes this
# unit the machine's registration and `terminate` stops it. What is expected to
# bounce a machine is `machinectl reboot`: it sends SIGINT, s6 reboots on that,
# and the Restart= below brings the machine back whatever exit status that path
# produces; `machinectl poweroff` is expected to do nothing, because it signals
# the container's PID 1 with a signal s6 does not handle. The reboot and
# poweroff verbs are derived rather than measured, and §1 is where the first
# soak's reading of them lands -- and where a firmware jump onto a newer base
# is re-read, since a newer systemd moves `terminate`.
Restart={{ restart }}
RestartSec={{ restart_delay }}
