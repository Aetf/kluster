#!/bin/bash
# Managed by the {{ cluster }} physical stack. Local edits are overwritten.
#
# Reinstall the dpkg packages that firmware updates wipe, and keep the offline
# deb cache in {{ cache }} current.
#
# Firmware updates wipe /usr and /var -- every apt-installed package, the dpkg
# records of them, and the apt lists -- while the new firmware image ships its
# own base-package dpkg database. So on the first boot after an update this
# script must run before anything that needs one of these packages. The whole
# set is installed in a single transaction, because packages that are
# version-locked to each other cannot be resolved one at a time.
#
# Cache design: the cache is what the firmware base lacks for the set -- the
# set's closure as apt resolves it against the dpkg database this firmware
# shipped, alternatives chosen as apt chooses them. That database is the base,
# saved under {{ base }} with the release of the firmware it came from. It is
# recorded on the boot that finds none of the set installed on a release the
# saved base is not from: the first boot after a firmware update, whose live
# database is the firmware's own with nothing of the set in it yet. Both halves
# are needed. Without the release, a boot interrupted while dpkg was unpacking
# leaves the set's dependencies behind and none of the set installed, and the
# boot after it would record that database as the firmware's. Every refresh
# has apt download the set against the saved base (Dir::State::status) into a
# directory of this script's own, never into its shared archives, so what
# survived on the live system changes nothing about what is fetched, and a deb
# that any other apt run left in the shared archives -- a vendor's, or one by
# hand -- is neither cached nor installed from the cache.
#
# That download replaces {{ cache }} whole, so the cache is exactly what the
# latest resolution named and never accumulates; a copy of the base's release
# goes in with it, naming the base it was resolved against. It replaces it only
# when apt fetched everything it planned and a deb of every package of the set
# is among it; a failed or partial download, or a base that lists part of the
# set as installed, keeps the old cache and says so.
#
# Until a firmware update's boot has recorded a base, what the firmware lacks
# is not known, and the cache is a superset rather than a resolution: the set
# downloaded by name, whatever the install fetched, and every package of the
# old cache the download did not carry -- at the version installed on the live
# system, so a package upgraded since it was cached is downloaded again at the
# installed version rather than kept beside dependencies of another. It never
# shrinks, so a push that grows the set does not lose the dependencies of the
# packages that survived; the next firmware update's boot records the base,
# and from then on the cache is exact.
#
# The cache is consumed when the install through apt fails, which on a
# post-update boot is above all when apt cannot reach the archive. It never
# downgrades a package the firmware ships: a deb whose package the saved base
# lists at a newer version is held back. So after a firmware update that ships
# such a package, an offline boot leaves the members of the set that pin it
# unpacked and fails, naming them, and the next boot that reaches apt installs
# the set against the firmware's version. Run from the boot chain, the script
# exits 0 only when every member of the set is installed, read back from dpkg
# after the install that put it there. A failure here stops
# nothing after it: udm-boot.service hands each file of on_boot.d to
# `xargs -n 1`, which runs every one whatever an earlier one exited with,
# unless it exited 255 -- and this script exits 0 or 1.
#
# {{ cache }} is this script's alone -- the swap below replaces it whole, so
# nothing else may keep a file in it.
#
# The firmware's package restore ({{ restore_unit }}) runs on the boot after a
# firmware update, the boot {{ fwupdate }} marks, and when it is done it kills
# whatever holds dpkg's locks (restore_dpkg_lock in /usr/sbin/ubnt-dpkg-restore,
# from its EXIT trap). So while it can still kill -- the mark is there, or the
# unit is activating -- the script starts the restore before it touches dpkg:
# `systemctl start` joins the start job the boot queued and returns once the
# oneshot is done, or at once when it is done already (RemainAfterExit=yes). The
# unit's own 30-minute start timeout counts only once its job runs, after
# unifi-core.service, and the boot chain's oneshot has no start timeout, so the
# call is bounded here, by RESTORE_TIMEOUT; a call cut off leaves the job in
# place and the run goes on behind dpkg's lock. The start cannot wait on the
# chain itself: nothing the restore is ordered after is ordered after
# udm-boot.service (read on the device, 2026-11-22, Aetf/kluster-ops#746). A
# restore that failed is not started again, since that would run it a second
# time. Any other boot that installs pays one `systemctl is-active`.
#
# dpkg's lock, as defence beside that wait, and the record that confirms it:
# dpkg is never run beside another dpkg. dpkg takes its locks without waiting
# (modstatdb_lock in dpkg's lib/dpkg/dbmodify.c, FILE_LOCK_NOWAIT), so a second
# dpkg refuses rather than overlapping, and apt waits for them only when
# DPkg::Lock::Timeout tells it to (debSystem::Lock in apt's
# apt-pkg/deb/debsystem.cc; the default is not to wait). So every apt run here
# waits up to LOCK_TIMEOUT seconds, and before the boot records the base, and
# before each dpkg it runs itself, it waits the same way, through apt, for
# whatever holds the lock. A lock still held when the wait ends is not broken:
# the base is not recorded, the step after it fails, and the boot with it.
#
# apt reports a dpkg that ended on a signal rather than exiting as
# "Sub-process ... exited unexpectedly", or as "received a segmentation fault"
# for SIGSEGV (pkgDPkgPM::Go in apt-pkg/deb/dpkgpm.cc; neither is translated).
# Such a dpkg leaves a journal it did not replay, and apt refuses to install
# until `dpkg --configure -a` replays it (debSystem::Lock, CheckUpdates). On
# that report the boot waits for the lock, runs `dpkg --configure -a`, and
# installs through apt once more. A second failure fails the boot, whatever the
# offline cache then installs.
#
# Every boot that goes past finding the set installed keeps what it found at
# dpkg's lock -- free, or held by which process and for how long -- what the
# kernel and the firmware's restore said of a dpkg that died, and how its
# install ended, one line each, in {{ history }}. That file is on /data, so it
# outlives the boot and the next firmware update, which the journal is not
# relied on to do.
#
# Run with no argument, as the boot chain runs it, it does all of the above.
# Given one of two arguments instead, it runs for a person or the homelab host:
#
#   --check    changes nothing, and says whether either of two reasons holds:
#              a member of the set with no deb in the cache, and a recorded
#              base the cache was not resolved against. It prints one line per
#              reason that holds and exits 1, and otherwise prints nothing and
#              exits 0. Before a base exists that pass says only that every
#              member has a deb: what the members need beyond the firmware is
#              not known, so a member installed outside this script can lack a
#              dependency the superset does not hold. The second reason is
#              what a firmware update whose first boot had no network leaves:
#              that boot installs the whole set from the cache and records the
#              new base, and every boot after it that finds the set installed
#              stops before apt, so nothing resolves the cache against the new
#              base until a run reaches apt.
#   --refresh  runs the refresh a boot runs after apt installed the set: the
#              set must be installed and apt reachable. A failed download keeps
#              the old cache and exits 1. Before a base exists it has no
#              install of its own, so a dependency the old cache lacks is not
#              fetched.

set -u

case "$#:${1-}" in
    0:) MODE=boot ;;
    1:--check) MODE=check ;;
    1:--refresh) MODE=refresh ;;
    *)
        echo "usage: $0 [--check | --refresh]" >&2
        exit 1
        ;;
esac

PACKAGES=({{ packages | join(' ') }})
CACHE={{ cache }}
# The firmware base. apt takes its locks in the directory of the status file it
# is pointed at, so the saved database is a directory of its own rather than a
# file beside the cache; `status` is the name dpkg gives the file, and `release`
# names the firmware it came from.
BASE={{ base }}
BASE_STATUS=$BASE/status
BASE_RELEASE=$BASE/release
# The release of the base the cache was resolved against: a copy of
# $BASE_RELEASE, written into the new cache before the swap, so it is replaced
# with the debs it describes. A cache refreshed without a base has none.
RESOLVED=release
# dpkg's database on the running system, which is what the base is saved from,
# and the running firmware's release, which is what it is saved under.
STATUS={{ status }}
RELEASE={{ release }}
# Where apt downloads: emptied before each use and removed when this script
# exits, so it holds what apt fetched on this run and nothing else. apt creates
# the partial/ directory it downloads through, but only inside an archives
# directory that already exists.
DOWNLOAD=$CACHE.download
# How long one wait for dpkg's lock lasts: how long a holder is waited for,
# which a first bound has to guess at, since nothing yet measures how long the
# firmware's own restore holds the lock; the record below says how long each
# wait took. A holder that never lets go costs three waits in a row -- before
# the base, apt's inside the install, before the offline cache -- about a
# quarter of an hour before the rest of the boot chain runs. On the boot after a
# firmware update the rest of the chain also waits for unifi-core.service and
# then the restore, up to the restore's 30 minutes, with RESTORE_TIMEOUT behind
# that.
LOCK_TIMEOUT=300
# How long the start of the firmware's restore is waited for: its 30-minute
# start timeout, and ten minutes for what its job waits for first.
RESTORE_TIMEOUT=2400
APT=(apt-get -o "Dir::Cache::archives=$DOWNLOAD" -o "DPkg::Lock::Timeout=$LOCK_TIMEOUT")
# dpkg's frontend lock, beside the live database, and the kernel's table of
# file locks, which names what holds it.
FRONTEND_LOCK=${STATUS%/*}/lock-frontend
LOCKS={{ locks }}
HISTORY={{ history }}
# The firmware's package restore, whose journal a dpkg killed under apt keeps
# a copy of (below).
RESTORE_UNIT={{ restore_unit }}
FWUPDATE={{ fwupdate }}
# The boot path's scratch, removed with the download directory: what apt said
# during the install, read for its report of a dpkg that did not exit and for
# its waits on the lock, and the journal cursors a death's record reads on
# from, so that each death keeps only the lines that came after the last one.
WORK=
OUTPUT=
# When the boot path began, which is where the first death's record starts.
STARTED=

# Say a line, and keep it in $HISTORY with the time and the firmware's release.
# A record that cannot be written costs the boot nothing.
say() {
    echo "$*"
    keep "$*"
}

warn() {
    echo "$*" >&2
    keep "$*"
}

keep() {
    { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $(head -n 1 "$RELEASE") $*" >>"$HISTORY"; } 2>/dev/null
}

is_installed() {
    [ "$(dpkg-query -W -f='${Status}' "$1" 2>/dev/null)" = 'install ok installed' ]
}

# The members of the set that are not installed, on one line.
missing_members() {
    local p missing=()
    for p in "${PACKAGES[@]}"; do
        is_installed "$p" || missing+=("$p")
    done
    echo "${missing[*]}"
}

# The command line of process $1, or nothing once it is gone.
command_line() {
    local line
    [ -n "$1" ] || return 0
    line=$(tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null)
    echo "${line% }"
}

# What holds dpkg's frontend lock, as the kernel's table of file locks names
# it: the holder's pid and command line, and its parent's, or nothing while the
# lock is free. dpkg and apt take it with fcntl, which the table lists as
# POSIX. The table is searched by inode alone, since it and stat need not agree
# on the device number under an overlay, and a pid it names counts only when
# it has the lock file open: a lock on another filesystem's file of the same
# inode number is not dpkg's.
lock_holder() {
    local inode pid parent fd lock
    inode=$(stat -c %i "$FRONTEND_LOCK" 2>/dev/null) || return 0
    lock=$(readlink -f "$FRONTEND_LOCK")
    for pid in $(awk -v inode="$inode" '$2 == "POSIX" { n = split($6, f, ":"); if (f[n] == inode) print $5 }' "$LOCKS"); do
        for fd in "/proc/$pid/fd/"*; do
            [ "$(readlink -f "$fd" 2>/dev/null)" = "$lock" ] || continue
            parent=$(awk '/^PPid:/ { print $2 }' "/proc/$pid/status" 2>/dev/null)
            echo "pid $pid ($(command_line "$pid")), child of pid ${parent:-unknown} ($(command_line "$parent"))"
            return 0
        done
    done
}

# Keep what says why a dpkg under apt died and will not outlast the boot: the
# kernel's lines of out-of-memory kills, and the firmware restore's journal,
# each since the run began or since the death before this one, whichever is
# later. journalctl's --cursor-file starts after the cursor it holds, once
# there is one, and writes the last entry's cursor back.
keep_death() {
    local line
    while IFS= read -r line; do
        keep "kernel: $line"
    done < <(journalctl -k -b --no-pager --since "@$STARTED" --cursor-file="$WORK/kernel.cursor" 2>/dev/null \
        | grep -iE 'out of memory|killed process')
    while IFS= read -r line; do
        keep "$RESTORE_UNIT: $line"
    done < <(journalctl -b --no-pager -u "$RESTORE_UNIT" --since "@$STARTED" --cursor-file="$WORK/restore.cursor" 2>/dev/null)
}

# Wait for dpkg's lock before $1, the way apt waits for it, and keep what was
# found: the lock free, or held by what and for how long. `apt-get check` is
# the wait: it takes the lock as an install does, and lets it go. What it says
# of the set's dependencies is not this wait's business, and its exit status
# is not read; the lock is read again instead. Returns 1 when the lock is still
# held, and the step after it then meets the holder itself.
wait_for_dpkg() {
    local holder start
    holder=$(lock_holder)
    if [ -z "$holder" ]; then
        say "packages: dpkg's lock is free before $1"
        return 0
    fi
    say "packages: dpkg's lock is held by $holder; waiting up to ${LOCK_TIMEOUT}s for it before $1"
    start=$SECONDS
    apt-get -o "DPkg::Lock::Timeout=$LOCK_TIMEOUT" check >/dev/null 2>&1
    holder=$(lock_holder)
    if [ -n "$holder" ]; then
        warn "packages: dpkg's lock is still held, by $holder, after $((SECONDS - start))s; going on to $1"
        return 1
    fi
    say "packages: dpkg's lock was released after $((SECONDS - start))s"
}

# Install the set through apt once, and read back from dpkg that every member
# is installed: apt's exit status alone does not say so. Sets `died` when apt
# reports that dpkg ended on a signal, and `finding` when apt exited 0 and
# left a member uninstalled.
install_through_apt() {
    local status missing line
    died=0
    "${APT[@]}" install -y "${PACKAGES[@]}" 2>&1 | tee "$OUTPUT"
    status=${PIPESTATUS[0]}
    # apt's own wait on the lock, which it prints and no line of this script's
    # covers: the holder it names, once.
    while IFS= read -r line; do
        keep "apt: $line"
    done < <(tr '\r' '\n' <"$OUTPUT" | grep -o 'Waiting for cache lock: .*held by process [0-9]*[^.]*' | sort -u)
    if grep -Eq 'Sub-process /usr/bin/dpkg (exited unexpectedly|received a segmentation fault)' "$OUTPUT"; then
        died=1
        warn "packages: dpkg ended on a signal during apt's install"
        keep_death
    fi
    [ "$status" -eq 0 ] || return 1
    missing=$(missing_members)
    if [ -n "$missing" ]; then
        warn "packages: apt's install exited 0 and left $missing not installed"
        finding=1
        return 1
    fi
    say "packages: installed ${PACKAGES[*]} through apt"
}

installed() {
    local p
    for p in "${PACKAGES[@]}"; do
        is_installed "$p" || return 1
    done
}

none_installed() {
    local p
    for p in "${PACKAGES[@]}"; do
        ! is_installed "$p" || return 1
    done
}

fresh_download() {
    rm -rf "$DOWNLOAD"
    mkdir -p "$DOWNLOAD"
}

# Whether the download holds a deb of package $1. apt names a deb for its
# package up to the first underscore, and a package name holds none.
carried() {
    compgen -G "$DOWNLOAD/${1}_*.deb" >/dev/null
}

# The version of package $1 installed on the live system, or nothing when it
# is not installed -- a record dpkg keeps of a removed package is not one.
installed_version() {
    is_installed "$1" && dpkg-query -W -f='${Version}' "$1" 2>/dev/null
}

# The version the saved firmware base lists package $1 installed at, or nothing
# when it lists no installation of it.
base_version() {
    [ -f "$BASE_STATUS" ] || return 0
    awk -v p="Package: $1" '
        BEGIN { RS = "" }
        {
            n = split($0, l, "\n")
            if (l[1] != p) next
            ok = 0
            for (i = 2; i <= n; i++) {
                if (l[i] == "Status: install ok installed") ok = 1
                if (l[i] ~ /^Version: /) version = substr(l[i], 10)
            }
            if (ok) { print version; exit }
        }' "$BASE_STATUS"
}

# The version of the deb at $1. apt names a deb <package>_<version>_<arch>.deb,
# with an epoch's colon written %3a.
deb_version() {
    local version=${1##*/}
    version=${version#*_}
    version=${version%_*}
    echo "${version//%3a/:}"
}

# Whether either reason holds -- a member of the set with no deb in the cache,
# or a recorded base the cache was not resolved against -- read without changing
# anything: no swap is completed and no download directory removed, so a run
# killed outright leaves what it left. The cache read is the one the next boot
# or refresh reads -- the new half of a swap cut short when there is no cache
# beside it.
check() {
    local p cache=$CACHE status=0
    if [ ! -d "$CACHE" ] && [ -d "$CACHE.new" ]; then
        cache=$CACHE.new
    fi
    for p in "${PACKAGES[@]}"; do
        if ! compgen -G "$cache/${p}_*.deb" >/dev/null; then
            echo "packages: the offline cache in $cache holds no deb of $p"
            status=1
        fi
    done
    # The release, written after the database, is what marks a base recorded.
    if [ -f "$BASE_RELEASE" ] && ! cmp -s "$BASE_RELEASE" "$cache/$RESOLVED"; then
        if [ -f "$cache/$RESOLVED" ]; then
            echo "packages: the offline cache in $cache was resolved against the firmware base of $(head -n 1 "$cache/$RESOLVED"), not the one recorded in $BASE for $(head -n 1 "$BASE_RELEASE")"
        else
            echo "packages: the offline cache in $cache was not resolved against the firmware base recorded in $BASE for $(head -n 1 "$BASE_RELEASE")"
        fi
        status=1
    fi
    return $status
}

# Replace the cache with what apt downloads for the set. Returns 1, keeping the
# old cache, when the download is not the whole of it.
refresh() {
    local p deb name cached version wanted=()
    if [ -f "$BASE_STATUS" ]; then
        # The install's debs are not reused: they were resolved against the
        # live system, and the cache is resolved against the base.
        fresh_download
        echo "packages: downloading what the firmware base in $BASE_STATUS lacks for ${PACKAGES[*]}, to refresh the offline cache in $CACHE"
        if ! "${APT[@]}" -o "Dir::State::status=$BASE_STATUS" install -y --download-only "${PACKAGES[@]}"; then
            echo "packages: cache refresh download failed, keeping the old cache"
            return 1
        fi
    else
        # The install's debs stay: they are the dependencies this boot found
        # missing, and --reinstall adds the set's own at the version apt holds.
        echo "packages: no firmware base in $BASE_STATUS yet: downloading ${PACKAGES[*]} and keeping every package of the old cache in $CACHE the download does not carry, until a firmware update's boot records the base"
        if ! "${APT[@]}" install -y --download-only --reinstall "${PACKAGES[@]}"; then
            echo "packages: cache refresh download failed, keeping the old cache"
            return 1
        fi
    fi
    for p in "${PACKAGES[@]}"; do
        if ! carried "$p"; then
            echo "packages: the refresh fetched no deb of $p, which the base in $BASE_STATUS lists as installed or apt could not download; keeping the old cache"
            return 1
        fi
    done
    if [ ! -f "$BASE_STATUS" ]; then
        for deb in "$CACHE"/*.deb; do
            [ -f "$deb" ] || continue
            name=${deb##*/}
            p=${name%%_*}
            carried "$p" && continue
            cached=$(deb_version "$deb")
            version=$(installed_version "$p")
            if [ -z "$version" ] || [ "$version" = "$cached" ]; then
                cp "$deb" "$DOWNLOAD/"
            else
                wanted+=("$p=$version")
            fi
        done
        if [ -n "${wanted[*]}" ]; then
            echo "packages: downloading ${wanted[*]}, installed at a version the old cache does not hold"
            if ! (cd "$DOWNLOAD" && apt-get download "${wanted[@]}"); then
                echo "packages: cache refresh download failed, keeping the old cache"
                return 1
            fi
        fi
    fi
    rm -rf "$CACHE.new" "$CACHE.old"
    mkdir -p "$CACHE.new"
    mv "$DOWNLOAD"/*.deb "$CACHE.new/"
    if [ -f "$BASE_STATUS" ] && [ -f "$BASE_RELEASE" ] \
        && ! cp "$BASE_RELEASE" "$CACHE.new/$RESOLVED"; then
        echo "packages: recording which base the new cache was resolved against failed, keeping the old cache"
        rm -rf "$CACHE.new"
        return 1
    fi
    [ -d "$CACHE" ] && mv "$CACHE" "$CACHE.old"
    mv "$CACHE.new" "$CACHE"
    rm -rf "$CACHE.old"
}

if [ "$MODE" = check ]; then
    check
    exit
fi

# Set before anything is downloaded, so that a run which exits anywhere, or is
# stopped by a signal, takes the directory with it; one killed outright leaves
# it for the next run, which empties it before using it.
trap 'rm -rf "$DOWNLOAD" ${WORK:+"$WORK"}' EXIT

# The swap is two renames. A run stopped between them leaves no cache and the
# whole new one beside it, which is put in place before anything reads the
# cache.
if [ ! -d "$CACHE" ] && [ -d "$CACHE.new" ]; then
    mv "$CACHE.new" "$CACHE"
fi

if [ "$MODE" = refresh ]; then
    if ! installed; then
        echo "packages: --refresh needs ${PACKAGES[*]} installed, and they are not all installed; the boot path (this script with no argument) installs them" >&2
        exit 1
    fi
    fresh_download
    # The lists are empty after a firmware update whose first boot had no
    # network; the download below cannot resolve anything without them.
    apt-get update || echo "packages: apt-get update failed, continuing"
    refresh
    exit
fi

if installed; then
    echo "packages: ${PACKAGES[*]} all present, nothing to do"
    exit 0
fi

WORK=$(mktemp -d)
OUTPUT=$WORK/apt.output
STARTED=$(date +%s)
# Set when this run fails whatever the offline cache installs: apt's install
# exited 0 and left a member uninstalled, or failed again on its one retry.
finding=0
say "packages: $(missing_members) not installed: installing ${PACKAGES[*]}"

# The boot after a firmware update: the firmware's restore kills whatever holds
# dpkg's locks when it is done, so nothing here touches dpkg while it still can.
if [ -e "$FWUPDATE" ] || [ "$(systemctl is-active "$RESTORE_UNIT" 2>/dev/null)" = activating ]; then
    if systemctl is-failed --quiet "$RESTORE_UNIT"; then
        warn "packages: the firmware's package restore $RESTORE_UNIT failed on this boot; not starting it again"
    else
        say "packages: the boot after a firmware update: waiting up to ${RESTORE_TIMEOUT}s for the firmware's package restore $RESTORE_UNIT before touching dpkg"
        restore_start=$SECONDS
        timeout "$RESTORE_TIMEOUT" systemctl start "$RESTORE_UNIT"
        restore_status=$?
        if [ "$restore_status" -eq 0 ]; then
            say "packages: the firmware's package restore was done after $((SECONDS - restore_start))s"
        elif [ "$restore_status" -eq 124 ]; then
            warn "packages: stopped waiting for the firmware's package restore after ${RESTORE_TIMEOUT}s; going on, behind dpkg's lock"
        else
            warn "packages: the firmware's package restore did not finish cleanly, after $((SECONDS - restore_start))s; going on, behind dpkg's lock"
        fi
    fi
fi
lock_free=0
wait_for_dpkg "recording the firmware base and installing the set" && lock_free=1

# Before anything is installed, which is the one moment the live database is
# the firmware's alone, and only once dpkg's lock is free, so that what is
# copied is a database no other dpkg is writing. The release is written last:
# it is what marks the record complete, and a run stopped before it, or one
# that found the lock still held, leaves the old release in place, so the next
# boot that finds none of the set installed records again.
if none_installed && ! cmp -s "$RELEASE" "$BASE_RELEASE"; then
    if [ "$lock_free" -eq 1 ]; then
        echo "packages: none of ${PACKAGES[*]} is installed on a firmware release the saved base is not from, so this is the firmware's own dpkg database: recording it as the base in $BASE_STATUS"
        mkdir -p "$BASE"
        { cp "$STATUS" "$BASE_STATUS.new" && mv "$BASE_STATUS.new" "$BASE_STATUS" \
            && cp "$RELEASE" "$BASE_RELEASE.new" && mv "$BASE_RELEASE.new" "$BASE_RELEASE"; } \
            || echo "packages: recording the base failed, the cache stays resolved against the one saved before"
    else
        warn "packages: not recording the firmware base while dpkg's lock is held: another dpkg may be part-way through writing the database"
    fi
fi

fresh_download

echo "packages: installing ${PACKAGES[*]} via apt (post-firmware-update boot)..."
# /var/lib/apt/lists is empty after a firmware update; without an update the
# install below cannot resolve anything. Its own failure is not fatal -- the
# install will fail and we fall back to the cache.
apt-get update || echo "packages: apt-get update failed, continuing"

# The update is the stretch of the run that waits on the network, so a holder
# can take the lock during it; apt's install waits for it, and the record keeps
# who it was.
holder=$(lock_holder)
if [ -n "$holder" ]; then
    say "packages: dpkg's lock is held by $holder after apt-get update; apt's install waits up to ${LOCK_TIMEOUT}s for it"
else
    say "packages: dpkg's lock is free after apt-get update"
fi

# A refresh that fails keeps the old cache and fails nothing here: the set is
# installed, and that is what this boot is for.
if install_through_apt; then
    refresh
    exit 0
fi

# A dpkg that ended on a signal is the one failure a second install can
# answer: what it left is replayed by `dpkg --configure -a`, which apt
# requires before it installs again. Another failure -- an archive out of
# reach, a maintainer script that fails -- meets a second install the same way.
if [ "$died" -eq 1 ]; then
    say "packages: replaying what the killed dpkg left with dpkg --configure -a and installing through apt once more"
    wait_for_dpkg "dpkg --configure -a"
    LC_ALL=C dpkg --configure -a
    if install_through_apt; then
        refresh
        exit 0
    fi
    if [ "$died" -eq 1 ]; then
        warn "packages: apt's install failed again after dpkg --configure -a: dpkg ended on a signal again"
    else
        warn "packages: apt's install failed again after dpkg --configure -a, and dpkg did not die this time"
    fi
    finding=1
fi

say "packages: apt failed, falling back to the offline cache $CACHE"
if ! compgen -G "$CACHE/*.deb" >/dev/null; then
    warn "packages: FAILED -- neither apt nor the offline cache could install ${PACKAGES[*]}"
    exit 1
fi

# The cache was resolved against the firmware that ran its last refresh, and an
# update since can ship a package of it at a newer version -- systemd, whenever
# the set's install upgraded it, since systemd-container pins it exactly. Such
# a deb is held back, and the firmware's package stays. What makes a package
# the firmware's is the saved base, recorded from the firmware's own database
# on the update's first boot, before anything is installed: a deb is held back
# when the base lists its package at a newer version than the cache's. A
# package installed at a newer version that the base does not list came from
# an apt run, not the firmware, and is replaced from the cache like any other.
#
# Every deb not held back goes to dpkg, which unpacks and configures it -- a
# package an install cut short left unpacked, or a failed maintainer script
# left half-configured, is replaced from the cache at whichever version, and
# configured.
#
# The script decides, not dpkg: --refuse-downgrade refuses against a package
# dpkg holds unpacked or half-configured as much as against an installed one, so
# it would keep exactly the leftovers the cache is there to repair, and
# --skip-same-version skips a package unpacked at the cache's version without
# configuring it.
debs=()
held=()
for deb in "$CACHE"/*.deb; do
    name=${deb##*/}
    p=${name%%_*}
    cached=$(deb_version "$deb")
    version=$(base_version "$p")
    if [ -n "$version" ] && dpkg --compare-versions "$version" gt "$cached"; then
        echo "packages: holding back the offline cache's $p $cached: the firmware ships $version"
        held+=("$p")
        continue
    fi
    debs+=("$deb")
done

# One dpkg -i invocation with every deb not held back: dpkg orders the closure
# itself. What depends on a held-back version -- systemd-container, and
# libnss-mymachines, which pins systemd-container in turn -- is unpacked and
# left unconfigured, and dpkg exits non-zero.
dpkg_status=0
if [ -n "${debs[*]}" ]; then
    wait_for_dpkg "installing the offline cache"
    yes | LC_ALL=C dpkg -i "${debs[@]}"
    dpkg_status=${PIPESTATUS[1]}
fi

# The boot succeeds when the set is up, and on nothing else: dpkg's exit status
# is not enough, since a cache from before the set last grew installs cleanly
# and still lacks a package of it.
missing=$(missing_members)
if [ "$dpkg_status" -eq 0 ] && [ -z "$missing" ] && [ "$finding" -eq 1 ]; then
    warn "packages: FAILED -- the offline cache installed ${PACKAGES[*]}, and the run fails all the same: apt's install did not, as said above"
    exit 1
fi
if [ "$dpkg_status" -eq 0 ] && [ -z "$missing" ]; then
    say "packages: installed ${PACKAGES[*]} from the offline cache"
    exit 0
fi
if [ -n "$missing" ]; then
    warn "packages: FAILED -- $missing not installed: neither apt nor the offline cache could install them"
else
    warn "packages: FAILED -- dpkg failed installing the offline cache $CACHE, though ${PACKAGES[*]} are installed"
fi
if [ -n "${held[*]}" ]; then
    echo "packages: the firmware's ${held[*]} stay at the versions it ships (held back above), so what the offline cache holds pinned to their older versions stays unconfigured until a boot whose apt install succeeds installs the set against this firmware" >&2
fi
exit 1
