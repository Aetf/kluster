#!/bin/bash
# Managed by the {{ cluster }} physical stack. Local edits are overwritten.
#
# Reinstall the dpkg packages that firmware updates wipe, and keep the offline
# deb cache in {{ cache }} current.
#
# Firmware updates wipe /usr and /var -- every apt-installed package, the dpkg
# records of them, and the apt lists -- while the new firmware image ships its
# own base-package dpkg database. So on the first boot after an update this
# script must run before anything that needs one of these packages. The whole
# set is installed in a single transaction, because packages that are
# version-locked to each other cannot be resolved one at a time.
#
# Cache design: the cache is what the firmware base lacks for the set -- the
# set's closure as apt resolves it against the dpkg database this firmware
# shipped, alternatives chosen as apt chooses them. That database is the base,
# saved under {{ base }} with the release of the firmware it came from. It is
# recorded on the boot that finds none of the set installed on a release the
# saved base is not from: the first boot after a firmware update, whose live
# database is the firmware's own with nothing of the set in it yet. Both halves
# are needed. Without the release, a boot interrupted while dpkg was unpacking
# leaves the set's dependencies behind and none of the set installed, and the
# boot after it would record that database as the firmware's. Every refresh
# has apt download the set against the saved base (Dir::State::status) into a
# directory of this script's own, never into its shared archives, so what
# survived on the live system changes nothing about what is fetched, and a deb
# that any other apt run left in the shared archives -- a vendor's, or one by
# hand -- is neither cached nor installed from the cache.
#
# That download replaces {{ cache }} whole, so the cache is exactly what the
# latest resolution named and never accumulates. It replaces it only when apt
# fetched everything it planned and a deb of every package of the set is among
# it; a failed or partial download, or a base that lists part of the set as
# installed, keeps the old cache and says so.
#
# Until a firmware update's boot has recorded a base, what the firmware lacks
# is not known, and the cache is a superset rather than a resolution: the set
# downloaded by name, whatever the install fetched, and every package of the
# old cache the download did not carry -- at the version installed on the live
# system, so a package upgraded since it was cached is downloaded again at the
# installed version rather than kept beside dependencies of another. It never
# shrinks, so a push that grows the set does not lose the dependencies of the
# packages that survived; the next firmware update's boot records the base,
# and from then on the cache is exact.
#
# The cache is consumed when the install through apt fails, which on a
# post-update boot is above all when apt cannot reach the archive. It never
# downgrades a package the firmware ships: a deb whose package the saved base
# lists at a newer version is held back. So after a firmware update that ships
# such a package, an offline boot leaves the members of the set that pin it
# unpacked and fails, naming them, and the next boot that reaches apt installs
# the set against the firmware's version. The script exits 0 only when every
# member of the set is installed. A failure here stops nothing after it:
# udm-boot.service hands each file of on_boot.d to `xargs -n 1`, which runs
# every one whatever an earlier one exited with, unless it exited 255 -- and
# this script exits 0 or 1.
#
# {{ cache }} is this script's alone -- the swap below replaces it whole, so
# nothing else may keep a file in it.

set -u

PACKAGES=({{ packages | join(' ') }})
CACHE={{ cache }}
# The firmware base. apt takes its locks in the directory of the status file it
# is pointed at, so the saved database is a directory of its own rather than a
# file beside the cache; `status` is the name dpkg gives the file, and `release`
# names the firmware it came from.
BASE={{ base }}
BASE_STATUS=$BASE/status
BASE_RELEASE=$BASE/release
# dpkg's database on the running system, which is what the base is saved from,
# and the running firmware's release, which is what it is saved under.
STATUS={{ status }}
RELEASE={{ release }}
# Where apt downloads: emptied before each use and removed when this script
# exits, so it holds what apt fetched on this run and nothing else. apt creates
# the partial/ directory it downloads through, but only inside an archives
# directory that already exists.
DOWNLOAD=$CACHE.download
APT=(apt-get -o "Dir::Cache::archives=$DOWNLOAD")
# Set before anything is downloaded, so that a run which exits anywhere, or is
# stopped by a signal, takes the directory with it; one killed outright leaves
# it for the next run, which empties it before using it.
trap 'rm -rf "$DOWNLOAD"' EXIT

# The swap below is two renames. A run stopped between them leaves no cache
# and the whole new one beside it, which is put in place before anything reads
# the cache.
if [ ! -d "$CACHE" ] && [ -d "$CACHE.new" ]; then
    mv "$CACHE.new" "$CACHE"
fi

is_installed() {
    dpkg -s "$1" 2>/dev/null | grep -q '^Status: install ok installed'
}

installed() {
    local p
    for p in "${PACKAGES[@]}"; do
        is_installed "$p" || return 1
    done
}

none_installed() {
    local p
    for p in "${PACKAGES[@]}"; do
        ! is_installed "$p" || return 1
    done
}

fresh_download() {
    rm -rf "$DOWNLOAD"
    mkdir -p "$DOWNLOAD"
}

# Whether the download holds a deb of package $1. apt names a deb for its
# package up to the first underscore, and a package name holds none.
carried() {
    compgen -G "$DOWNLOAD/${1}_*.deb" >/dev/null
}

# The version of package $1 installed on the live system, or nothing when it
# is not installed -- a record dpkg keeps of a removed package is not one.
installed_version() {
    dpkg -s "$1" 2>/dev/null | awk '
        /^Status: / { ok = ($0 == "Status: install ok installed") }
        /^Version: / { version = $2 }
        END { if (ok) print version }'
}

# The version the saved firmware base lists package $1 installed at, or nothing
# when it lists no installation of it.
base_version() {
    [ -f "$BASE_STATUS" ] || return 0
    awk -v p="Package: $1" '
        BEGIN { RS = "" }
        {
            n = split($0, l, "\n")
            if (l[1] != p) next
            ok = 0
            for (i = 2; i <= n; i++) {
                if (l[i] == "Status: install ok installed") ok = 1
                if (l[i] ~ /^Version: /) version = substr(l[i], 10)
            }
            if (ok) { print version; exit }
        }' "$BASE_STATUS"
}

# The version of the deb at $1. apt names a deb <package>_<version>_<arch>.deb,
# with an epoch's colon written %3a.
deb_version() {
    local version=${1##*/}
    version=${version#*_}
    version=${version%_*}
    echo "${version//%3a/:}"
}

refresh() {
    local p deb name cached version wanted=()
    if [ -f "$BASE_STATUS" ]; then
        # The install's debs are not reused: they were resolved against the
        # live system, and the cache is resolved against the base.
        fresh_download
        echo "packages: downloading what the firmware base in $BASE_STATUS lacks for ${PACKAGES[*]}, to refresh the offline cache in $CACHE"
        if ! "${APT[@]}" -o "Dir::State::status=$BASE_STATUS" install -y --download-only "${PACKAGES[@]}"; then
            echo "packages: cache refresh download failed, keeping the old cache"
            return
        fi
    else
        # The install's debs stay: they are the dependencies this boot found
        # missing, and --reinstall adds the set's own at the version apt holds.
        echo "packages: no firmware base in $BASE_STATUS yet: downloading ${PACKAGES[*]} and keeping every package of the old cache in $CACHE the download does not carry, until a firmware update's boot records the base"
        if ! "${APT[@]}" install -y --download-only --reinstall "${PACKAGES[@]}"; then
            echo "packages: cache refresh download failed, keeping the old cache"
            return
        fi
    fi
    for p in "${PACKAGES[@]}"; do
        if ! carried "$p"; then
            echo "packages: the refresh fetched no deb of $p, which the base in $BASE_STATUS lists as installed or apt could not download; keeping the old cache"
            return
        fi
    done
    if [ ! -f "$BASE_STATUS" ]; then
        for deb in "$CACHE"/*.deb; do
            [ -f "$deb" ] || continue
            name=${deb##*/}
            p=${name%%_*}
            carried "$p" && continue
            cached=$(deb_version "$deb")
            version=$(installed_version "$p")
            if [ -z "$version" ] || [ "$version" = "$cached" ]; then
                cp "$deb" "$DOWNLOAD/"
            else
                wanted+=("$p=$version")
            fi
        done
        if [ -n "${wanted[*]}" ]; then
            echo "packages: downloading ${wanted[*]}, installed at a version the old cache does not hold"
            if ! (cd "$DOWNLOAD" && apt-get download "${wanted[@]}"); then
                echo "packages: cache refresh download failed, keeping the old cache"
                return
            fi
        fi
    fi
    rm -rf "$CACHE.new" "$CACHE.old"
    mkdir -p "$CACHE.new"
    mv "$DOWNLOAD"/*.deb "$CACHE.new/"
    [ -d "$CACHE" ] && mv "$CACHE" "$CACHE.old"
    mv "$CACHE.new" "$CACHE"
    rm -rf "$CACHE.old"
}

if installed; then
    echo "packages: ${PACKAGES[*]} all present, nothing to do"
    exit 0
fi

# Before anything is installed, which is the one moment the live database is
# the firmware's alone. The release is written last: it is what marks the
# record complete, and a run stopped before it leaves the old release in
# place, so the next boot -- which still finds none of the set, since the
# install comes after this -- records again.
if none_installed && ! cmp -s "$RELEASE" "$BASE_RELEASE"; then
    echo "packages: none of ${PACKAGES[*]} is installed on a firmware release the saved base is not from, so this is the firmware's own dpkg database: recording it as the base in $BASE_STATUS"
    mkdir -p "$BASE"
    { cp "$STATUS" "$BASE_STATUS.new" && mv "$BASE_STATUS.new" "$BASE_STATUS" \
        && cp "$RELEASE" "$BASE_RELEASE.new" && mv "$BASE_RELEASE.new" "$BASE_RELEASE"; } \
        || echo "packages: recording the base failed, the cache stays resolved against the one saved before"
fi

fresh_download

echo "packages: installing ${PACKAGES[*]} via apt (post-firmware-update boot)..."
# /var/lib/apt/lists is empty after a firmware update; without an update the
# install below cannot resolve anything. Its own failure is not fatal -- the
# install will fail and we fall back to the cache.
apt-get update || echo "packages: apt-get update failed, continuing"

if "${APT[@]}" install -y "${PACKAGES[@]}"; then
    refresh
    exit 0
fi

echo "packages: apt failed, falling back to the offline cache $CACHE"
if ! compgen -G "$CACHE/*.deb" >/dev/null; then
    echo "packages: FAILED -- neither apt nor the offline cache could install ${PACKAGES[*]}" >&2
    exit 1
fi

# The cache was resolved against the firmware that ran its last refresh, and an
# update since can ship a package of it at a newer version -- systemd, whenever
# the set's install upgraded it, since systemd-container pins it exactly. Such
# a deb is held back, and the firmware's package stays. What makes a package
# the firmware's is the saved base, recorded from the firmware's own database
# on the update's first boot, before anything is installed: a deb is held back
# when the base lists its package at a newer version than the cache's. A
# package installed at a newer version that the base does not list came from
# an apt run, not the firmware, and is replaced from the cache like any other.
#
# Every deb not held back goes to dpkg, which unpacks and configures it -- a
# package an install cut short left unpacked, or a failed maintainer script
# left half-configured, is replaced from the cache at whichever version, and
# configured.
#
# The script decides, not dpkg: --refuse-downgrade refuses against a package
# dpkg holds unpacked or half-configured as much as against an installed one, so
# it would keep exactly the leftovers the cache is there to repair, and
# --skip-same-version skips a package unpacked at the cache's version without
# configuring it.
debs=()
held=()
for deb in "$CACHE"/*.deb; do
    name=${deb##*/}
    p=${name%%_*}
    cached=$(deb_version "$deb")
    version=$(base_version "$p")
    if [ -n "$version" ] && dpkg --compare-versions "$version" gt "$cached"; then
        echo "packages: holding back the offline cache's $p $cached: the firmware ships $version"
        held+=("$p")
        continue
    fi
    debs+=("$deb")
done

# One dpkg -i invocation with every deb not held back: dpkg orders the closure
# itself. What depends on a held-back version -- systemd-container, and
# libnss-mymachines, which pins systemd-container in turn -- is unpacked and
# left unconfigured, and dpkg exits non-zero.
dpkg_status=0
if [ -n "${debs[*]}" ]; then
    yes | LC_ALL=C dpkg -i "${debs[@]}"
    dpkg_status=${PIPESTATUS[1]}
fi

# The boot succeeds when the set is up, and on nothing else: dpkg's exit status
# is not enough, since a cache from before the set last grew installs cleanly
# and still lacks a package of it.
missing=()
for p in "${PACKAGES[@]}"; do
    is_installed "$p" || missing+=("$p")
done
if [ "$dpkg_status" -eq 0 ] && [ -z "${missing[*]}" ]; then
    exit 0
fi
if [ -n "${missing[*]}" ]; then
    echo "packages: FAILED -- ${missing[*]} not installed: neither apt nor the offline cache could install them" >&2
else
    echo "packages: FAILED -- dpkg failed installing the offline cache $CACHE, though ${PACKAGES[*]} are installed" >&2
fi
if [ -n "${held[*]}" ]; then
    echo "packages: the firmware's ${held[*]} stay at the versions it ships (held back above), so what the offline cache holds pinned to their older versions stays unconfigured until a boot whose apt install succeeds installs the set against this firmware" >&2
fi
exit 1
